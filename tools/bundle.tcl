#!/usr/bin/env tclsh
# Packs the whole app into ONE file you can copy to a phone:
#     tclsh tools/bundle.tcl [output-file]        (default: dist/learn-tcl.tcl)
set root [file dirname [file dirname [file normalize [info script]]]]
set out [expr {$argc ? [lindex $argv 0] : [file join $root dist learn-tcl.tcl]}]

proc slurp {path} {
    set f [open $path r]
    fconfigure $f -encoding utf-8
    set d [read $f]
    close $f
    return $d
}
set main [slurp $root/main.tcl]
if {![regexp {set ::app_lib \{([^\}]*)\}} $main -> libs] ||
    ![regexp {set ::app_content \{([^\}]*)\}} $main -> units]} {
    error "cannot find the file lists in main.tcl"
}
set files {}
foreach l $libs  { lappend files lib/$l.tcl }
foreach u $units { lappend files content/$u.tcl }

file mkdir [file dirname $out]
set f [open $out w]
fconfigure $f -encoding utf-8
puts $f "# Learn Tcl - single-file bundle, generated by tools/bundle.tcl. Do not edit."
puts $f "# Run with wish (desktop) or AndroWish (Android)."
# build number = minutes since 2026-01-01; the APK build uses the same number as its versionCode
set build [expr {([clock seconds] - 1767225600) / 60}]
puts $f "set ::LEARNTCL_BUILD $build"
set embed {}
foreach rel $files { lappend embed $rel [slurp $root/$rel] }
puts $f "array set ::EMBED [list $embed]"
puts -nonewline $f $main
close $f
puts "wrote $out ([file size $out] bytes, [llength $files] embedded files)"
