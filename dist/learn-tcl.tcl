 \ \ \ pack\ \$body.ab\ -fill\ x\ -padx\ \$pad\n\ \ \ \ frame\ \$body.pad\ -bg\ \$::T(bg)\ -height\ \[ui::px\ 10\]\n\ \ \ \ pack\ \$body.pad\n\ \ \ \ ui::dragify\ \$::app::view\n\ \ \ \ flat::freeze\ \[curScroll\]\n\}\nproc\ app::drawWeek\ \{c\ W\ H\}\ \{\n\ \ \ \ \$c\ delete\ all\n\ \ \ \ set\ today\ \[util::today\]\n\ \ \ \ set\ mx\ 20\n\ \ \ \ for\ \{set\ i\ 6\}\ \{\$i\ >=\ 0\}\ \{incr\ i\ -1\}\ \{\n\ \ \ \ \ \ \ \ set\ d\ \[expr\ \{\$today\ -\ \$i\}\]\n\ \ \ \ \ \ \ \ set\ v\ \[expr\ \{\[dict\ exists\ \$::state\ daily\ \$d\]\ ?\ \[dict\ get\ \$::state\ daily\ \$d\]\ :\ 0\}\]\n\ \ \ \ \ \ \ \ set\ mx\ \[expr\ \{max(\$mx,\ \$v)\}\]\n\ \ \ \ \}\n\ \ \ \ set\ colW\ \[expr\ \{\$W\ /\ 7.0\}\]\n\ \ \ \ set\ base\ \[expr\ \{\$H\ -\ \[ui::px\ 7\]\}\]\n\ \ \ \ for\ \{set\ i\ 6\;\ set\ k\ 0\}\ \{\$i\ >=\ 0\}\ \{incr\ i\ -1\;\ incr\ k\}\ \{\n\ \ \ \ \ \ \ \ set\ d\ \[expr\ \{\$today\ -\ \$i\}\]\n\ \ \ \ \ \ \ \ set\ v\ \[expr\ \{\[dict\ exists\ \$::state\ daily\ \$d\]\ ?\ \[dict\ get\ \$::state\ daily\ \$d\]\ :\ 0\}\]\n\ \ \ \ \ \ \ \ set\ cx\ \[expr\ \{\$colW\ *\ (\$k\ +\ .5)\}\]\n\ \ \ \ \ \ \ \ set\ bh\ \[expr\ \{\$v\ >\ 0\ ?\ max(\[ui::px\ 2\],\ (\$base\ -\ \[ui::px\ 3\])\ *\ double(\$v)\ /\ \$mx)\ :\ \[ui::px\ 1\]\}\]\n\ \ \ \ \ \ \ \ set\ bw\ \[expr\ \{\$colW\ *\ .46\}\]\n\ \ \ \ \ \ \ \ set\ col\ \[expr\ \{\$v\ >=\ \[store::setting\ goal\ 50\]\ ?\ \$::T(success)\ :\ (\$v\ >\ 0\ ?\ \$::T(primary)\ :\ \$::T(surface2))\}\]\n\ \ \ \ \ \ \ \ ui::rrect\ \$c\ \[expr\ \{\$cx\ -\ \$bw/2\}\]\ \[expr\ \{\$base\ -\ \$bh\}\]\ \[expr\ \{\$cx\ +\ \$bw/2\}\]\ \$base\ \[ui::px\ 1.2\]\ -fill\ \$col\ -outline\ \"\"\n\ \ \ \ \ \ \ \ \$c\ create\ text\ \$cx\ \[expr\ \{\$H\ -\ \[ui::px\ 3\]\}\]\ -text\ \[util::dayName\ \$d\]\ -font\ f.small\ -fill\ \[expr\ \{\$i\ ==\ 0\ ?\ \$::T(text)\ :\ \$::T(muted)\}\]\n\ \ \ \ \}\n\}\nproc\ app::setScale\ \{v\}\ \{\ store::setSetting\ textScale\ \$v\;\ set\ ui::fscale\ \$v\;\ ui::fonts\;\ screenProfile\ \}\nproc\ app::setGoal\ \{g\}\ \{\ store::setSetting\ goal\ \$g\;\ screenProfile\ \}\nproc\ app::setTheme\ \{t\}\ \{\ store::setSetting\ theme\ \$t\;\ theme::apply\ \$t\;\ screenProfile\ \}\nproc\ app::setUnlock\ \{v\}\ \{\ store::setSetting\ unlockAll\ \$v\;\ screenProfile\ \}\nproc\ app::doReset\ \{\}\ \{\ store::reset\;\ theme::apply\ dark\;\ app::go\ home\ \}\n content/u01.tcl {content::unit 1 "First steps" "What a program is, and your very first Tcl commands." "#8B7CFF"

content::lesson 1.1 1 "Hello, Tcl" "What a program is, and how to make the computer say something." {
pages {
  {head "What is a program?" body {
    p {A **program** is a list of instructions for a computer, a bit like a recipe. The computer follows the steps one at a time, from top to bottom, and does exactly what you wrote - nothing more, nothing less.}
    p {**Tcl** (say "tickle", short for Tool Command Language) is a programming language created in 1988. It is easy to start with and surprisingly deep: it is used in testing tools, chip design, networking gear - and the screens and buttons of this very app are built with Tcl's toolkit, Tk.}
    tip {By the end of this course you will be able to read and write real Tcl programs. We start at the very beginning, so nothing is assumed.}
  }}
  {head "Your first command" body {
    p {Here is one line of Tcl. The command `puts` (say "put string") prints text on the screen.}
    code {puts "Hello, world!"}
    out {Hello, world!}
    p {The text is wrapped in double quotes so Tcl knows where it starts and ends. The quotes themselves are not printed.}
    tip {Open the **Playground** tab at any time and type this in yourself. Typing code - even code you have just seen - is how it sticks.}
  }}
  {head "More than one line" body {
    p {Tcl runs your lines **in order, top to bottom**.}
    code {puts "First"
puts "Second"
puts "Third"}
    out {First
Second
Third}
    p {Each line is a separate instruction. Change the order of the lines and you change the result.}
  }}
}
ex {
  {kind mc q {What is a program?} choices {{A list of instructions a computer follows} {A kind of computer screen} {A type of keyboard} {A game you download}} ans 0 why {A program is a list of instructions. The computer follows them one by one.}}
  {kind predict code {puts "Hi there"} choices {{Hi there} {"Hi there"} {puts Hi there} {Hi}} ans 0 why {`puts` prints the text. The quotes only mark where the text begins and ends, so they are not printed.}}
  {kind mc q {Which Tcl command prints text on the screen?} choices {puts print echo show} ans 0 why {In Tcl the command is `puts`, short for "put string".}}
  {kind predict code {puts "A"
puts "B"} choices {"A\nB" "B\nA" "AB" "A B"} ans 0 why {Lines run top to bottom, and each `puts` starts a new line of output, so you get A and then B on separate lines.}}
  {kind blank q {Complete the program so it prints Hello, Tcl!} code {___ "Hello, Tcl!"} answers {puts} extra {print echo say} out {Hello, Tcl!} why {`puts` is the command that prints text.}}
  {kind order q {Make the program print One, then Two, then Three.} lines {{puts "One"} {puts "Two"} {puts "Three"}} out {One
Two
Three} why {Tcl runs the lines from top to bottom, so the order of the lines is the order of the output.}}
  {kind type q {Type the command that prints text to the screen.} accept {puts} why {`puts` - "put string".}}
}
cards {
  {{What does `puts` do?} {It prints text on the screen and moves to a new line. The name means "put string".}}
  {{In what order does Tcl run the lines of a program?} {From top to bottom, one at a time.}}
  {{How do you print the words Hello there?} {`puts "Hello there"`}}
  {{What is a program?} {A list of instructions that a computer follows, one step at a time.}}
}
}

content::lesson 1.2 1 "Commands and words" "The one rule that all of Tcl is built on." {
pages {
  {head "Commands are made of words" body {
    p {Every Tcl instruction is a **command**: a list of **words** separated by spaces. The first word is the name of the command. The remaining words are its **arguments** - the information you hand to it.}
    code {puts "Hello"}
    p {Here `puts` is the command and `"Hello"` is its one argument.}
    p {Tcl has almost no hidden grammar. If you can see where each word starts and ends, you understand the line. This simplicity is Tcl's big idea, and it gets easier from here.}
  }}
  {head "Quotes make one word" body {
    p {Spaces split words. Double quotes glue several words into **one** word.}
    code {puts "Hello, world!"}
    p {Without the quotes Tcl sees two words, and `puts` gets confused:}
    code {puts Hello world}
    out {can not find channel named "Hello"}
    p {`puts` can take an optional extra first argument (a "channel" such as `stdout`). Given two arguments, it assumes the first one names a channel. That is why it complains about `Hello`.}
    tip {Error messages are your friend. They usually tell you exactly what went wrong - read them slowly.}
  }}
  {head "One line, one command" body {
    p {A command ends where the line ends. To put two commands on a single line, separate them with a semicolon.}
    code {puts "A"; puts "B"}
    out {A
B}
    p {Most of the time you will write one command per line - it is easier to read.}
  }}
}
ex {
  {kind mc q {In the line `puts "Hi"`, which word is the command?} choices {puts {"Hi"} {Hi} {The quote marks}} ans 0 why {The first word of a line is always the command name. Everything after it is an argument.}}
  {kind mc q {How many words are in the line `puts Hello World`?} choices {1 2 3 4} ans 2 why {Spaces separate words: `puts`, `Hello` and `World` - three words.}}
  {kind predict code {puts one; puts two} choices {"one\ntwo" "two\none" "one two" onetwo} ans 0 why {A semicolon separates two commands on one line. They run left to right.}}
  {kind mc q {What do double quotes do in Tcl?} choices {{Group several words into one word} {Make text appear in bold} {Start a comment} {Mark a number}} ans 0 why {Inside quotes, spaces no longer split words, so the whole thing is a single argument.}}
  {kind mc q {What happens when you run `puts Hello world`?} choices {{It prints Hello world} {It fails - puts is given two arguments and thinks Hello is a channel} {It prints Hello only} {It prints nothing at all and succeeds}} ans 1 why {Two arguments means "channel, then text". Fix it with quotes: `puts "Hello world"`.}}
  {kind blank q {Fill in the blanks to print two words as one argument.} code {puts ___Good morning___} answers {{"} {"}} extra {{'} {(}} out {Good morning} why {Double quotes make `Good morning` a single word.}}
  {kind type q {Which character can separate two commands written on the same line?} accept {; semicolon} hint {It is also used at the end of lines in many other languages.} why {The semicolon: `puts "A"; puts "B"`.}}
}
cards {
  {{What is a Tcl command made of?} {Words separated by spaces. The first word is the command name; the rest are its arguments.}}
  {{What do double quotes do?} {They group several words into one word (one argument).}}
  {{How can two commands share one line?} {Separate them with a semicolon, for example `puts "A"; puts "B"`.}}
  {{Why does `puts Hello world` fail?} {It has two arguments, so Tcl treats Hello as a channel name. Quote the text: `puts "Hello world"`.}}
}
}

content::lesson 1.3 1 "Comments and special characters" "Leave notes for humans, and print tabs, quotes and line breaks." {
pages {
  {head "Notes for humans" body {
    p {A line that begins with `#` is a **comment**. Tcl skips it completely. Comments explain *why* the code does something - they are notes to the next reader (often future you).}
    code {# Greet the user
puts "Hello!"}
    out {Hello!}
    p {To put a comment at the end of a line, you need a semicolon first:}
    code {puts "Hi" ;# this note is ignored}
    out {Hi}
    warn {Without the `;` the `#` would just be another argument to `puts`, because a comment may only start where a command could start.}
  }}
  {head "Special characters" body {
    p {Inside double quotes, a backslash starts an **escape sequence**:}
    p {- `\n` starts a new line
- `\t` inserts a tab
- `\"` prints a quote mark
- `\\` prints one backslash}
    code {puts "Line one\nLine two"}
    out {Line one
Line two}
    code {puts "She said \"hi\""}
    out {She said "hi"}
  }}
  {head "Staying on the same line" body {
    p {Normally `puts` adds a newline at the end. The `-nonewline` option turns that off, so the next output continues on the same line.}
    code {puts -nonewline "Loading"
puts "..."}
    out {Loading...}
    p {An option like `-nonewline` goes **before** the text, and starts with a dash. You will meet many commands with options.}
  }}
}
ex {
  {kind type q {Which character starts a comment?} accept {#} why {A `#` at the start of a command turns the rest of the line into a comment.}}
  {kind predict code {# puts "hidden"
puts "shown"} choices {shown hidden {hidden
shown} {nothing}} ans 0 why {The first line is a comment, so Tcl ignores it.}}
  {kind predict code {puts "One\nTwo"} choices {"One\nTwo" {One\nTwo} {One Two} OneTwo} ans 0 why {Inside double quotes `\n` becomes a line break, so the text is printed on two lines.}}
  {kind predict code {puts -nonewline "A"
puts "B"} choices {AB "A\nB" B A} ans 0 why {`-nonewline` stops `puts` from adding a line break, so B follows A directly.}}
  {kind mc q {What does `\t` put into text?} choices {{A tab} {A new line} {A quote mark} {The letter t}} ans 0 why {`\t` is a tab character; `\n` is a new line.}}
  {kind blank q {Complete the line so it prints a quote mark around hi.} code {puts "She said ___hi___"} answers {{\"} {\"}} extra {{"} {\n}} out {She said "hi"} why {A backslash before a quote mark prints it instead of ending the text.}}
  {kind order q {Print Hello, Tcl on a single line.} lines {{puts -nonewline "Hello, "} {puts "Tcl"}} out {Hello, Tcl} why {The first `puts` leaves the cursor on the same line, so the second one continues it.}}
}
cards {
  {{How do you write a comment in Tcl?} {Start a command with `#`. Tcl ignores the rest of that line.}}
  {{How do you add a comment after a command on the same line?} {Put a semicolon first: `puts "Hi" ;# note`.}}
  {{What do `\n`, `\t` and `\"` mean inside double quotes?} {New line, tab, and a literal quote mark.}}
  {{What does `puts -nonewline` do?} {It prints text without adding a line break at the end.}}
}
}
} content/u02.tcl {content::unit 2 "Values and variables" "Give names to things, reuse results, and learn how Tcl reads text." "#4C9AFF"

content::lesson 2.1 2 "Variables: naming things" "Store a value once, use it as often as you like." {
pages {
  {head "Boxes with names" body {
    p {A **variable** is a named box that holds a value. The command `set` puts a value into the box.}
    code {set name "Ada"
puts $name}
    out {Ada}
    p {`set name "Ada"` means: make a variable called `name` and put `Ada` in it. To **use** the contents, write a dollar sign before the name: `$name`.}
    tip {Read `$name` out loud as "the value of name".}
  }}
  {head "Changing and combining" body {
    p {A variable can change. Setting it again replaces the old value.}
    code {set score 10
puts $score
set score 15
puts $score}
    out {10
15}
    p {Inside double quotes Tcl swaps each `$name` for its value. This is called **variable substitution**.}
    code {set first "Grace"
set last "Hopper"
puts "$first $last"}
    out {Grace Hopper}
  }}
  {head "Naming rules" body {
    p {Names are **case sensitive**: `Name` and `name` are two different variables. Use letters, digits and underscores, and choose names that explain themselves - `total_price` beats `x`.}
    p {Using a variable that was never set is an error:}
    code {puts $missing}
    out {can't read "missing": no such variable}
    warn {If you see "no such variable", check the spelling and the capital letters.}
  }}
}
ex {
  {kind predict code {set a 3
puts $a} choices {3 a {$a} {set a 3}} ans 0 why {`$a` is replaced by the value stored in `a`, which is 3.}}
  {kind predict code {set x hello
set x world
puts $x} choices {world hello {hello world} x} ans 0 why {The second `set` replaces the first value, so the variable now holds `world`.}}
  {kind mc q {What does the `$` mean in front of a variable name?} choices {{"the value of" the variable} {"start a comment"} {"divide"} {"print this"}} ans 0 why {`$name` means "use the value stored in name".}}
  {kind predict code {set lang "Tcl"
puts "I love $lang"} choices {{I love Tcl} {I love $lang} {Tcl} {I love lang}} ans 0 why {Inside double quotes `$lang` is replaced by its value.}}
  {kind blank q {Print the contents of the variable city.} code {set city "Paris"
puts ___city} answers {$} extra {# & %} out {Paris} why {A dollar sign in front of the name fetches the value.}}
  {kind order q {Print hello world using a variable.} lines {{set who "world"} {puts "hello $who"}} out {hello world} why {A variable must be set before it is used, so `set` comes first.}}
  {kind type q {Which command gives a variable a value?} accept {set} why {`set name value` creates or changes a variable.}}
  {kind mc q {Are `Score` and `score` the same variable?} choices {{No - names are case sensitive} {Yes - capitals are ignored} {Only inside quotes} {Only on Android}} ans 0 why {Tcl is case sensitive everywhere, including variable names.}}
}
cards {
  {{How do you create a variable called age with the value 30?} {`set age 30`}}
  {{How do you read the value of a variable called age?} {Put a dollar sign in front: `$age`.}}
  {{Are Tcl variable names case sensitive?} {Yes. `Age` and `age` are different variables.}}
  {{What error do you get for a variable that was never set?} {`can't read "name": no such variable`}}
}
}

content::lesson 2.2 2 "Using a command's result" "Square brackets run a command and use what it returns." {
pages {
  {head "Square brackets" body {
    p {Many commands produce a **result**. Square brackets run a command and put its result into the line.}
    code {puts [string length "hello"]}
    out {5}
    p {Tcl runs the command in the brackets **first**. `[string length "hello"]` becomes `5`, and then the line is simply `puts 5`.}
    p {`string length` is one of many `string` commands. You will meet more soon.}
  }}
  {head "Keeping results" body {
    p {Combine brackets with `set` to keep a result in a variable.}
    code {set n [string length "Tcl rocks"]
puts "Length: $n"}
    out {Length: 9}
    code {set shout [string toupper "hey"]
puts $shout}
    out {HEY}
    p {Brackets can be nested. The innermost one runs first.}
    code {puts [string toupper [string range "hello" 0 1]]}
    out {HE}
    tip {Read nested brackets from the inside out. `string range "hello" 0 1` gives `he`, then `string toupper` turns it into `HE`.}
  }}
  {head "Brackets inside quotes" body {
    p {Square brackets also work inside double quotes, which is handy for building messages.}
    code {puts "Tcl has [string length Tcl] letters"}
    out {Tcl has 3 letters}
    p {Inside curly braces nothing is substituted, so `puts {[string length Tcl]}` would print the brackets as plain text.}
  }}
}
ex {
  {kind mc q {What do square brackets do in Tcl?} choices {{Run a command and use its result} {Make a list} {Start a comment} {Group words into one}} ans 0 why {`[command ...]` is replaced by the result of running the command.}}
  {kind predict code {puts [string length "banana"]} choices {6 banana 5 {string length banana}} ans 0 why {"banana" has 6 letters.}}
  {kind predict code {set w "tcl"
puts [string toupper $w]} choices {TCL tcl Tcl w} ans 0 why {`string toupper` returns the text in capitals.}}
  {kind predict code {puts "Ada has [string length Ada] letters"} choices {{Ada has 3 letters} {Ada has [string length Ada] letters} {Ada has Ada letters} {3 letters}} ans 0 why {Brackets are substituted inside double quotes too.}}
  {kind predict code {puts [string toupper [string index "hello" 0]]} choices {H h HELLO he} ans 0 why {`string index "hello" 0` is `h` (counting starts at 0), and `string toupper` makes it `H`.}}
  {kind blank q {Store the length of "Tcl" in n.} code {set n [___ length "Tcl"]
puts $n} answers {string} extra {str len count} out {3} why {`string length` returns how many characters a text has.}}
  {kind order q {Print: banana has 6 letters} lines {{set word "banana"} {set n [string length $word]} {puts "$word has $n letters"}} out {banana has 6 letters} why {Set the word, measure it, then print - each line uses what the previous one made.}}
  {kind mc q {In `puts [string length "hi"]`, which part runs first?} choices {{string length "hi"} {puts} {Both at once} {Neither}} ans 0 why {The bracketed command runs first; its result (2) becomes the argument for `puts`.}}
}
cards {
  {{What do [square brackets] do?} {They run the command inside and replace themselves with its result.}}
  {{What does `string length hello` return?} {5 - the number of characters.}}
  {{How do you keep a command's result in a variable?} {`set n [command ...]`}}
  {{In nested brackets, which command runs first?} {The innermost one.}}
}
}

content::lesson 2.3 2 "Quotes, braces and joining" "Everything is text - and the two ways to group it." {
pages {
  {head "Everything is a string" body {
    p {In Tcl every value is text. The number 5 is just the character `5` until you do arithmetic with it (next unit). There are no types to declare, and variables can hold anything.}
    code {set a 5
set b 7
puts "$a$b"}
    out {57}
    p {Writing two values side by side simply joins the text.}
  }}
  {head "Quotes versus braces" body {
    p {There are two ways to group words into one:}
    p {- `"..."` double quotes: `$variables` and `[commands]` are **replaced**
- `{...}` curly braces: everything is taken **literally**}
    code {set name "Ada"
puts "Hi $name"
puts {Hi $name}}
    out {Hi Ada
Hi $name}
    tip {Braces mean "leave this exactly as it is". You will see them everywhere - around the body of `if`, `proc` and loops - because those pieces of code should not run yet.}
  }}
  {head "Building text with append" body {
    p {`append` adds text to the end of a variable.}
    code {set s "Hello"
append s ", " "world"
puts $s}
    out {Hello, world}
    p {You do not write a `$` before the variable name in `append`: the command wants the *name*, not the value.}
  }}
}
ex {
  {kind predict code {set name "Ada"
puts "Hi $name"
puts {Hi $name}} choices {"Hi Ada\nHi $name" "Hi Ada\nHi Ada" "Hi $name\nHi $name" "Hi $name\nHi Ada"} ans 0 why {Double quotes substitute the variable; braces do not.}}
  {kind mc q {Which line prints the text $x exactly as written?} choices {{puts {$x}} {puts "$x"} {puts $x} {puts [$x]}} ans 0 why {Only braces stop substitution, so `{$x}` stays as the characters $x.}}
  {kind predict code {set a 5
set b 7
puts "$a$b"} choices {57 12 {5 7} {$a$b}} ans 0 why {Text is joined side by side - no arithmetic happens in quotes.}}
  {kind predict code {set s "Hello"
append s ", " "world"
puts $s} choices {{Hello, world} {Hello} {, world} {s}} ans 0 why {`append` adds each piece to the end of `s`.}}
  {kind blank q {Make the message use the value of x.} code {set x 42
puts ___Value: $x___} answers {{"} {"}} extra {{'} {(}} out {Value: 42} why {Double quotes allow `$x` to be replaced by 42.}}
  {kind order q {Build and print: Learning Tcl} lines {{set msg "Learning"} {append msg " Tcl"} {puts $msg}} out {Learning Tcl} why {Create the variable, extend it, then print it.}}
  {kind type q {Which command adds text to the end of a variable?} accept {append} why {`append name text`.}}
  {kind predict code {puts {2 + 3}} choices {{2 + 3} 5 {{2 + 3}} 23} ans 0 why {Braces keep the text exactly as written. Tcl does not do maths unless you ask with `expr`.}}
}
cards {
  {{What is the difference between "..." and {...}?} {Double quotes allow $variable and [command] substitution. Braces take everything literally.}}
  {{What type are values in Tcl?} {Everything is a string. Tcl reads a value as a number only when you do maths with it.}}
  {{How do you add text to the end of the variable s?} {`append s " more text"` (no dollar sign before s).}}
  {{What does `puts {Hi $name}` print?} {`Hi $name` - braces prevent substitution.}}
}
}
} content/u03.tcl {content::unit 3 "Numbers and decisions" "Do maths, compare things, and make your program choose." "#2DD4BF"

content::lesson 3.1 3 "Maths with expr" "Teach Tcl to calculate." {
pages {
  {head "expr does the maths" body {
    p {Tcl does not calculate unless you ask. The `expr` command evaluates a mathematical expression and returns the answer.}
    code {puts [expr {2 + 3}]}
    out {5}
    code {set price 4
set qty 3
puts [expr {$price * $qty}]}
    out {12}
    tip {Always put the expression in **curly braces**: `expr {2 + 3}`. It is safer and faster, and you will see why in the expert unit.}
  }}
  {head "The operators" body {
    p {- `+` `-` `*` add, subtract, multiply
- `/` divide
- `%` the remainder after dividing
- `**` to the power of
- `( )` to control the order}
    code {puts [expr {7 / 2}]
puts [expr {7 / 2.0}]
puts [expr {7 % 2}]
puts [expr {2 ** 10}]}
    out {3
3.5
1
1024}
    warn {When both numbers are whole, `/` throws the remainder away: `7 / 2` is `3`. Make one of them a decimal (`2.0`) to get `3.5`.}
  }}
  {head "Functions and incr" body {
    p {Inside `expr` you can call maths functions: `sqrt()`, `abs()`, `round()`, `max()`, `min()` and more.}
    code {puts [expr {sqrt(16)}]
puts [expr {round(3.6)}]
puts [expr {max(3, 9, 5)}]}
    out {4.0
4
9}
    p {Adding one to a variable is so common that it has its own command: `incr`.}
    code {set n 5
incr n
incr n 10
puts $n}
    out {16}
    p {`incr n` adds 1; `incr n 10` adds 10. Like `append`, it takes the variable's name without a dollar sign.}
  }}
}
ex {
  {kind predict code {puts [expr {10 % 3}]} choices {1 3 3.33 0} ans 0 why {10 divided by 3 is 3 remainder 1; `%` gives the remainder.}}
  {kind predict code {puts [expr {2 + 3 * 4}]} choices {14 20 24 9} ans 0 why {Multiplication comes before addition, like in school maths: 3 * 4 = 12, plus 2.}}
  {kind predict code {puts [expr {(2 + 3) * 4}]} choices {20 14 24 9} ans 0 why {Brackets are evaluated first.}}
  {kind predict code {puts [expr {9 / 2}]} choices {4 4.5 5 2} ans 0 why {Both numbers are whole, so the division is a whole-number division.}}
  {kind predict code {puts [expr {9 / 2.0}]} choices {4.5 4 5 9} ans 0 why {One decimal number is enough to get a decimal answer.}}
  {kind predict code {set n 7
incr n 3
puts $n} choices {10 8 73 n} ans 0 why {`incr n 3` adds 3 to n.}}
  {kind blank q {Multiply 4 by 5.} code {puts [___ {4 * 5}]} answers {expr} extra {calc math eval} out {20} why {`expr` evaluates the expression.}}
  {kind order q {Print the area of a 3 by 4 rectangle (12).} lines {{set w 3} {set h 4} {puts [expr {$w * $h}]}} out {12} why {Set both variables first, then calculate.}}
  {kind type q {What does `expr {17 % 5}` return?} accept {2} calc {expr {17 % 5}} res 1 why {17 = 3 * 5 + 2, so the remainder is 2.}}
}
cards {
  {{Which command does maths in Tcl?} {`expr`, as in `expr {2 + 3}`. Put the expression in braces.}}
  {{What does `expr {7 / 2}` return, and why?} {3. Both numbers are whole, so the remainder is dropped. Use 2.0 to get 3.5.}}
  {{What does `%` do?} {It gives the remainder of a division: `expr {10 % 3}` is 1.}}
  {{How do you add 1 to the variable n?} {`incr n` (and `incr n 5` adds 5).}}
}
}

content::lesson 3.2 3 "Making decisions: if" "Run code only when something is true." {
pages {
  {head "if" body {
    p {`if` runs some code **only when** a condition is true. The condition goes in curly braces, then the code to run goes in curly braces.}
    code {set age 20
if {$age >= 18} {
    puts "adult"
}}
    out {adult}
    p {Comparison operators: `==` equal, `!=` not equal, `<` less than, `>` greater than, `<=` and `>=`.}
    tip {Indent the code inside braces by four spaces. It does not matter to Tcl, but it makes your program readable.}
  }}
  {head "else and elseif" body {
    p {Add `else` for "otherwise", and `elseif` for further questions. Tcl checks from the top and stops at the first true one.}
    code {set temp 15
if {$temp > 25} {
    puts "hot"
} elseif {$temp > 10} {
    puts "mild"
} else {
    puts "cold"
}}
    out {mild}
    warn {`else` and `elseif` must start on the **same line** as the closing brace of the block before them. A new line would end the `if` command early.}
  }}
  {head "Combining conditions" body {
    p {- `&&` means **and**: both sides must be true
- `||` means **or**: at least one must be true
- `!` means **not**}
    code {set n 7
if {$n > 0 && $n < 10} {
    puts "single digit"
}}
    out {single digit}
    p {To compare **text**, use `eq` (equal) and `ne` (not equal). They always compare character by character.}
    code {set color "red"
if {$color eq "red" || $color eq "green"} {
    puts "warm or green"
}}
    out {warm or green}
  }}
}
ex {
  {kind predict code {set n 5
if {$n > 3} {
    puts "big"
} else {
    puts "small"
}} choices {big small {big
small} nothing} ans 0 why {5 is greater than 3, so the first block runs and the `else` is skipped.}}
  {kind predict code {set n 2
if {$n > 3} {
    puts "big"
} elseif {$n > 1} {
    puts "medium"
} else {
    puts "small"
}} choices {medium big small nothing} ans 0 why {2 is not greater than 3, but it is greater than 1, so `medium` is printed.}}
  {kind predict code {set a 4
if {$a > 0 && $a < 3} {
    puts "yes"
} else {
    puts "no"
}} choices {no yes {yes
no} nothing} ans 0 why {`&&` needs both sides true. 4 is greater than 0 but not less than 3.}}
  {kind predict code {set s "hi"
if {$s eq "hi"} {puts match}} choices {match hi nothing eq} ans 0 why {`eq` compares text. The two texts are identical.}}
  {kind mc q {What does `||` mean in a condition?} choices {{or - at least one side is true} {and - both sides are true} {not} {divide}} ans 0 why {`||` is "or"; `&&` is "and".}}
  {kind mc q {Why does this code fail?} code {set x 1
if {$x > 5} {
    puts "big"
}
else {
    puts "small"
}} choices {{`else` must be on the same line as the closing brace} {`>` is not allowed in an if} {`puts` needs two arguments} {Nothing - it works fine}} ans 0 why {The first line break ends the `if` command, so Tcl then tries to run `else` as a separate command. Keep `else` on the same line as the closing brace.}}
  {kind blank q {Complete the condition: print adult when age is at least 18.} code {set age 30
if {$age ___ 18} {
    puts "adult"
}} answers {>=} extra {<= == !=} out {adult} why {`>=` means greater than or equal to.}}
  {kind order q {Print big if the number is over 10.} lines {{set n 12} {if {$n > 10} {puts "big"}}} out {big} why {Set the variable first, then test it in the `if`.}}
  {kind type q {Which word do you use for "otherwise" in an if command?} accept {else} why {`else`.}}
}
cards {
  {{How does `if` look?} {`if {condition} { code }` - optionally with `elseif {condition} { code }` and `else { code }`.}}
  {{What do `&&`, `||` and `!` mean?} {And, or, not.}}
  {{How do you compare two pieces of text?} {Use `eq` (equal) and `ne` (not equal).}}
  {{Where must `else` be written?} {On the same line as the closing brace of the previous block.}}
}
}

content::lesson 3.3 3 "switch and truth values" "Choose between many options, and what Tcl counts as true." {
pages {
  {head "switch" body {
    p {When you compare one value against many possibilities, `switch` is tidier than a long chain of `elseif`.}
    code {set day "Sat"
switch $day {
    Sat - Sun { puts "weekend" }
    Fri       { puts "almost!" }
    default   { puts "weekday" }
}}
    out {weekend}
    p {Each pattern is followed by the code to run. A `-` instead of code means "use the same code as the next pattern". `default` matches anything not matched earlier.}
  }}
  {head "True and false" body {
    p {A condition can be anything that Tcl understands as a yes/no value. Comparisons return `1` (true) or `0` (false), and these words also work: `true` `false` `yes` `no` `on` `off`.}
    code {puts [expr {3 > 2}]
puts [expr {3 < 2}]
set done yes
if {$done} { puts "finished" }}
    out {1
0
finished}
    p {`!` flips a truth value.}
    code {set found 0
if {!$found} { puts "not found yet" }}
    out {not found yet}
  }}
  {head "Handy expression tricks" body {
    p {`expr` has a one-line choice, `condition ? a : b`:}
    code {set n -4
puts [expr {$n >= 0 ? "positive" : "negative"}]}
    out {negative}
    p {And `in` tests whether a value is in a list of choices:}
    code {set c "b"
puts [expr {$c in {a b c}}]}
    out {1}
    tip {`ni` is the opposite of `in` ("not in").}
  }}
}
ex {
  {kind predict code {set x "b"
switch $x {
    a { puts "first" }
    b { puts "second" }
    default { puts "other" }
}} choices {second first other {first
second}} ans 0 why {`b` matches the second pattern, so only that code runs.}}
  {kind predict code {set x "z"
switch $x {
    a { puts "first" }
    default { puts "other" }
}} choices {other first nothing z} ans 0 why {Nothing matches `z`, so the `default` branch runs.}}
  {kind predict code {puts [expr {5 == 5}]} choices {1 0 true 5} ans 0 why {A true comparison gives 1.}}
  {kind predict code {set ok no
if {$ok} {puts yes} else {puts no}} choices {no yes nothing ok} ans 0 why {Tcl treats `no` as false.}}
  {kind predict code {set n 8
puts [expr {$n % 2 == 0 ? "even" : "odd"}]} choices {even odd 0 8} ans 0 why {8 divided by 2 leaves remainder 0, so the condition is true and the first choice is used.}}
  {kind predict code {puts [expr {"x" in {a b c}}]} choices {0 1 x false} ans 0 why {`x` is not in the list, so the result is 0.}}
  {kind blank q {Fill in the keyword for "everything else".} code {set k "q"
switch $k {
    a { puts "A" }
    ___ { puts "something else" }
}} answers {default} extra {else other otherwise} out {something else} why {`default` is the catch-all branch of a switch.}}
  {kind mc q {Which of these is NOT understood as false by Tcl?} choices {yes 0 false off} ans 0 why {`yes` means true. `0`, `false` and `off` all mean false.}}
  {kind type q {What does `expr {4 > 9}` return?} accept {0} calc {expr {4 > 9}} res 1 why {Comparisons return 1 for true and 0 for false.}}
}
cards {
  {{What is `switch` for?} {Comparing one value against many patterns, with `default` as the catch-all.}}
  {{Which words does Tcl treat as true and false?} {true/yes/on/1 and false/no/off/0.}}
  {{How do you write a one-line choice inside expr?} {`condition ? valueIfTrue : valueIfFalse`}}
  {{What does `$x in {a b c}` test?} {Whether x is one of the listed items (1 if so, else 0). `ni` means not in.}}
}
}
} content/u04.tcl {content::unit 4 "Loops" "Make the computer repeat work - the heart of programming." "#4ADE80"

content::lesson 4.1 4 "while loops" "Repeat code for as long as a condition holds." {
pages {
  {head "Repeating things" body {
    p {A **loop** runs the same code again and again. `while` keeps going as long as its condition is true.}
    code {set i 1
while {$i <= 3} {
    puts "Round $i"
    incr i
}}
    out {Round 1
Round 2
Round 3}
    p {Tcl checks the condition. If it is true, it runs the body, then checks again. When it is false, the loop ends and the program carries on after it.}
  }}
  {head "Do not loop forever" body {
    p {Something inside the loop must eventually make the condition false. Here `incr` pulls the number down to zero. (`incr n -1` subtracts 1.)}
    code {set n 3
while {$n > 0} {
    puts $n
    incr n -1
}
puts "Liftoff!"}
    out {3
2
1
Liftoff!}
    warn {If nothing changes the variable in the condition, the loop never ends. In this app the Playground stops runaway code after a few seconds.}
  }}
  {head "Adding things up" body {
    p {A common pattern: keep a running **total** in a variable.}
    code {set total 0
set i 1
while {$i <= 5} {
    incr total $i
    incr i
}
puts $total}
    out {15}
    p {The total grows 0, 1, 3, 6, 10, 15 - the sum of the numbers 1 to 5.}
  }}
}
ex {
  {kind predict code {set i 1
while {$i <= 3} {
    puts $i
    incr i
}} choices {"1\n2\n3" "1\n2" "0\n1\n2" "3"} ans 0 why {The loop runs while `i` is 1, 2 and 3. When `i` becomes 4 the condition is false.}}
  {kind predict code {set n 10
while {$n > 4} {
    puts $n
    incr n -3
}} choices {"10\n7" "10\n7\n4" "10\n7\n4\n1" "7\n4"} ans 0 why {n goes 10, 7, 4. When n is 4 the test `4 > 4` is false, so 4 is never printed.}}
  {kind predict code {set t 0
set i 1
while {$i <= 4} {
    incr t $i
    incr i
}
puts $t} choices {10 4 24 6} ans 0 why {1 + 2 + 3 + 4 = 10.}}
  {kind mc q {Why does this loop never stop?} code {set i 1
while {$i < 5} {
    puts $i
}} choices {{Nothing changes i, so the condition stays true} {puts is not allowed in loops} {while needs a semicolon} {The number 5 is too small}} ans 0 why {`i` is always 1. Add `incr i` inside the body.}}
  {kind blank q {Make the loop print 0, 1, 2.} code {set i 0
while {$i < 3} {
    puts $i
    ___ i
}} answers {incr} extra {set expr puts} out {0
1
2} why {`incr i` adds 1 each time round.}}
  {kind order q {Print 0, 1, 2 with a loop.} lines {{set i 0} {while {$i < 3} {puts $i; incr i}}} out {0
1
2} why {Initialise the counter first, then loop.}}
  {kind type q {Which command adds 1 to a variable?} accept {incr} why {`incr name` - and `incr name 5` adds 5.}}
  {kind mc q {The condition is `$i < 5` and i starts at 0, increasing by 1. How many times does the body run?} choices {5 4 6 1} ans 0 why {i takes the values 0, 1, 2, 3 and 4 - five times.}}
}
cards {
  {{What does `while` do?} {It repeats its body for as long as the condition is true, checking before every round.}}
  {{How do you count down by 1?} {`incr n -1`}}
  {{What must happen inside a while loop?} {Something must change so the condition eventually becomes false - otherwise it loops forever.}}
  {{How do you keep a running total?} {Start with `set total 0` and then `incr total $value` inside the loop.}}
}
}

content::lesson 4.2 4 "for loops" "The tidy way to count." {
pages {
  {head "Count with for" body {
    p {A counting loop has three parts: where to start, when to stop, and how to step. `for` writes them all on one line.}
    code {for {set i 1} {$i <= 3} {incr i} {
    puts "Round $i"
}}
    out {Round 1
Round 2
Round 3}
    p {The four parts in braces are: **start**, **test**, **next**, **body**. The start runs once; then test, body, next repeat.}
  }}
  {head "Counting patterns" body {
    p {Change the start, test and step to count in other ways.}
    code {for {set i 10} {$i > 0} {incr i -3} {
    puts $i
}}
    out {10
7
4
1}
    code {for {set i 0} {$i <= 10} {incr i 5} {
    puts $i
}}
    out {0
5
10}
    tip {Use `for` when you know how many rounds you want, and `while` when you wait for something to happen.}
  }}
  {head "Loops inside loops" body {
    p {A loop can sit inside another loop. The inner loop runs completely for each round of the outer one.}
    code {for {set r 1} {$r <= 2} {incr r} {
    for {set c 1} {$c <= 3} {incr c} {
        puts "$r x $c = [expr {$r * $c}]"
    }
}}
    out {1 x 1 = 1
1 x 2 = 2
1 x 3 = 3
2 x 1 = 2
2 x 2 = 4
2 x 3 = 6}
  }}
}
ex {
  {kind predict code {for {set i 1} {$i <= 4} {incr i} {
    puts $i
}} choices {"1\n2\n3\n4" "1\n2\n3" "0\n1\n2\n3" "4"} ans 0 why {i starts at 1 and the loop runs while i is at most 4.}}
  {kind predict code {for {set i 0} {$i < 10} {incr i 4} {
    puts $i
}} choices {"0\n4\n8" "0\n4\n8\n12" "4\n8" "0\n10"} ans 0 why {0, 4, 8 - then 12 is not less than 10.}}
  {kind predict code {set s 0
for {set i 1} {$i <= 3} {incr i} {
    incr s [expr {$i * $i}]
}
puts $s} choices {14 6 9 3} ans 0 why {1 + 4 + 9 = 14, the sum of the squares of 1, 2 and 3.}}
  {kind predict code {for {set i 3} {$i > 0} {incr i -1} {
    puts -nonewline $i
}} choices {321 123 210 3} ans 0 why {Counting down 3, 2, 1, printed without line breaks.}}
  {kind mc q {In `for {set i 0} {$i < 5} {incr i} {...}`, which part runs only once?} choices {{set i 0} {$i < 5} {incr i} {The body}} ans 0 why {The start part runs once at the beginning. The test runs before each round, and the "next" part after each round.}}
  {kind blank q {Count from 1 to 3.} code {for {set i 1} {$i ___ 3} {incr i} {
    puts $i
}} answers {<=} extra {< > ==} out {1
2
3} why {`<=` includes 3 in the loop.}}
  {kind order q {Add up 1, 2 and 3 with a loop and print the total.} lines {{set sum 0} {for {set i 1} {$i <= 3} {incr i} {incr sum $i}} {puts $sum}} out {6} why {Start the total at 0, add inside the loop, and print only after the loop is finished.}}
  {kind type q {Which loop command is best for counting from a start to an end?} accept {for} why {`for` puts start, test and step on one line.}}
}
cards {
  {{What are the four parts of `for`?} {`for {start} {test} {next} {body}` - start runs once, then test, body, next repeat.}}
  {{How do you count from 10 down to 1?} {`for {set i 10} {$i >= 1} {incr i -1} {...}`}}
  {{When should you use `while` instead of `for`?} {When you do not know in advance how many rounds are needed - you wait for a condition.}}
  {{What happens with a loop inside a loop?} {The inner loop runs completely for every round of the outer loop.}}
}
}

content::lesson 4.3 4 "foreach, break and continue" "Do something for every item, and control the loop from inside." {
pages {
  {head "foreach" body {
    p {`foreach` runs its body once for **each item of a list**. A list is simply words separated by spaces.}
    code {foreach fruit {apple banana cherry} {
    puts "I like $fruit"
}}
    out {I like apple
I like banana
I like cherry}
    p {No counting needed. This is the loop you will use most often.}
  }}
  {head "Totals and pairs" body {
    p {Add up the items of a list:}
    code {set total 0
foreach n {4 8 15} {
    incr total $n
}
puts $total}
    out {27}
    p {Give `foreach` two variable names and it takes the items two at a time:}
    code {foreach {key val} {a 1 b 2} {
    puts "$key is $val"
}}
    out {a is 1
b is 2}
  }}
  {head "break and continue" body {
    p {Two commands steer a loop from the inside:}
    p {- `break` leaves the loop immediately
- `continue` skips the rest of this round and starts the next one}
    code {foreach n {3 8 5 12 7} {
    if {$n > 10} {break}
    puts $n
}}
    out {3
8
5}
    code {foreach n {1 2 3 4} {
    if {$n == 3} {continue}
    puts $n
}}
    out {1
2
4}
  }}
}
ex {
  {kind predict code {foreach c {x y z} {
    puts $c
}} choices {"x\ny\nz" "z\ny\nx" "xyz" "x y z"} ans 0 why {The body runs once per item, in order.}}
  {kind predict code {set t 0
foreach n {5 10 20} {incr t $n}
puts $t} choices {35 30 15 20} ans 0 why {5 + 10 + 20 = 35.}}
  {kind predict code {foreach {a b} {1 2 3 4} {
    puts [expr {$a + $b}]
}} choices {"3\n7" "10" "1\n2\n3\n4" "3\n4"} ans 0 why {Two items per round: (1, 2) then (3, 4). The sums are 3 and 7.}}
  {kind predict code {foreach n {3 8 5 12 7} {
    if {$n > 10} {break}
    puts $n
}} choices {"3\n8\n5" "3\n8\n5\n7" "12" "3\n8\n5\n12"} ans 0 why {`break` ends the loop when it reaches 12, so 7 is never visited.}}
  {kind predict code {foreach n {1 2 3 4} {
    if {$n == 3} {continue}
    puts $n
}} choices {"1\n2\n4" "1\n2" "3" "1\n2\n3\n4"} ans 0 why {`continue` skips printing when n is 3 but the loop carries on with 4.}}
  {kind mc q {What does `break` do?} choices {{Leaves the loop right away} {Skips to the next round} {Stops the whole program} {Pauses for a moment}} ans 0 why {`break` exits the innermost loop. `continue` skips to the next round.}}
  {kind blank q {Skip the number 2.} code {foreach n {1 2 3} {
    if {$n == 2} {___}
    puts $n
}} answers {continue} extra {break stop skip} out {1
3} why {`continue` jumps straight to the next item.}}
  {kind type q {Which command goes through every item of a list?} accept {foreach} why {`foreach`.}}
}
cards {
  {{What does `foreach` do?} {Runs the body once for each item of a list: `foreach item $list {...}`.}}
  {{What do `break` and `continue` do?} {`break` leaves the loop; `continue` skips to the next round.}}
  {{How can foreach take two items per round?} {Give it two variable names: `foreach {k v} $list {...}`.}}
  {{Which loop would you choose to process every item in a list?} {`foreach`.}}
}
}
} content/u05.tcl {content::unit 5 "Procedures" "Create your own commands and organise programs into reusable pieces." "#FACC15"

content::lesson 5.1 5 "Your own commands" "Write code once, use it everywhere." {
pages {
  {head "proc" body {
    p {A **procedure** is a command that *you* create. `proc` defines it: first the name, then the parameter names in braces, then the body in braces.}
    code {proc greet {name} {
    puts "Hello, $name!"
}
greet "Ada"
greet "Linus"}
    out {Hello, Ada!
Hello, Linus!}
    p {Defining a proc does not run it. The body runs each time you call it, and `name` is filled in with whatever you pass.}
  }}
  {head "Giving back a result" body {
    p {`return` hands a value back to whoever called the procedure. Call the proc in square brackets to use the result.}
    code {proc double {x} {
    return [expr {$x * 2}]
}
puts [double 21]}
    out {42}
    tip {If a proc has no `return`, it gives back the result of its **last command**. So `proc double {x} {expr {$x * 2}}` works too.}
  }}
  {head "More than one parameter" body {
    p {List several parameter names. The caller must provide exactly that many values.}
    code {proc area {w h} {
    expr {$w * $h}
}
puts [area 3 4]}
    out {12}
    p {Call it with the wrong number of values and Tcl tells you the right shape:}
    code {area 3}
    out {wrong # args: should be "area w h"}
  }}
}
ex {
  {kind predict code {proc hello {} {
    puts "hi"
}
hello
hello} choices {"hi\nhi" hi "hello\nhello" nothing} ans 0 why {Calling the proc twice runs its body twice.}}
  {kind predict code {proc square {n} {
    return [expr {$n * $n}]
}
puts [square 7]} choices {49 14 7 n} ans 0 why {7 times 7 is 49.}}
  {kind predict code {proc add {a b} {expr {$a + $b}}
puts [add 2 3]} choices {5 23 {2 3} a} ans 0 why {The proc returns the result of its last command, `expr {$a + $b}`.}}
  {kind predict code {proc shout {s} {
    return [string toupper $s]
}
puts "[shout hey]!"} choices {HEY! hey! HEY {[shout hey]!}} ans 0 why {The call in brackets is replaced by its result, then `!` follows.}}
  {kind mc q {What does `return` do?} choices {{Hands a value back to the caller and ends the proc} {Prints a value} {Starts a loop} {Defines a variable}} ans 0 why {`return` gives a result back and leaves the procedure.}}
  {kind blank q {Define a proc that adds one to a number.} code {___ inc {n} {
    return [expr {$n + 1}]
}
puts [inc 9]} answers {proc} extra {def func set} out {10} why {`proc name {params} {body}` defines a procedure.}}
  {kind order q {Define a proc called twice and use it.} lines {{proc twice {x} {expr {$x * 2}}} {puts [twice 8]}} out {16} why {Define before you call - Tcl needs to know the command first.}}
  {kind type q {Which command defines a new procedure?} accept {proc} why {`proc`.}}
  {kind code prompt {Write a proc called **triple** that returns its argument times three.} starter {proc triple {n} {
    # your code here
}} solution {proc triple {n} {
    return [expr {$n * 3}]
}} tests {{triple 4} 12 {triple 0} 0 {triple -2} -6} why {The body must compute n * 3 and return it.}}
}
cards {
  {{How do you define a procedure?} {`proc name {param1 param2} {body}`}}
  {{What does a proc return if it has no `return`?} {The result of the last command in its body.}}
  {{How do you use a proc's result inside another command?} {Call it in square brackets: `puts [double 21]`.}}
  {{What error appears with the wrong number of arguments?} {`wrong # args: should be "name param1 param2"`}}
}
}

content::lesson 5.2 5 "Defaults and flexible arguments" "Optional parameters, any number of arguments and early exits." {
pages {
  {head "Default values" body {
    p {Give a parameter a **default** by writing the name and the default together in braces. Callers may then leave it out.}
    code {proc greet {{name "friend"}} {
    return "Hello, $name!"
}
puts [greet]
puts [greet "Ada"]}
    out {Hello, friend!
Hello, Ada!}
    p {Parameters with defaults must come **after** the required ones.}
  }}
  {head "Any number of arguments" body {
    p {If the last parameter is called `args`, it collects **all** the remaining values into a list.}
    code {proc sum {args} {
    set total 0
    foreach n $args {incr total $n}
    return $total
}
puts [sum 1 2 3 4]
puts [sum]}
    out {10
0}
    tip {`puts` itself, `expr max(...)` and `list` all work this way.}
  }}
  {head "Returning early" body {
    p {`return` leaves the procedure immediately, even from the middle of a loop or an `if`. This keeps code flat and readable.}
    code {proc sign {n} {
    if {$n < 0} {return "negative"}
    if {$n == 0} {return "zero"}
    return "positive"
}
puts [sign -5]
puts [sign 0]
puts [sign 12]}
    out {negative
zero
positive}
    p {To give back **two** values, return a list: `return [list $a $b]`.}
  }}
}
ex {
  {kind predict code {proc hi {{who "you"}} {return "hi $who"}
puts [hi]
puts [hi Ann]} choices {"hi you\nhi Ann" "hi\nhi Ann" "hi you\nhi you" "hi Ann\nhi Ann"} ans 0 why {Without an argument the default `you` is used.}}
  {kind predict code {proc count {args} {return [llength $args]}
puts [count a b c]} choices {3 1 a 0} ans 0 why {`args` collects every value into a list; `llength` counts its items.}}
  {kind predict code {proc max2 {a b} {
    if {$a > $b} {return $a}
    return $b
}
puts [max2 4 9]} choices {9 4 13 b} ans 0 why {4 > 9 is false, so execution continues to the final `return $b`.}}
  {kind predict code {proc f {n} {
    foreach x {1 2 3 4} {
        if {$x == $n} {return "found $x"}
    }
    return "none"
}
puts [f 3]
puts [f 9]} choices {"found 3\nnone" "found 3\nfound 9" "none\nnone" "3\n9"} ans 0 why {`return` exits the proc from inside the loop as soon as the item is found.}}
  {kind mc q {Where must parameters with defaults appear?} choices {{After the required parameters} {Before the required parameters} {Anywhere} {They cannot be used}} ans 0 why {Tcl fills parameters left to right; optional ones go last.}}
  {kind blank q {Collect any number of values.} code {proc total {___} {
    set t 0
    foreach n $args {incr t $n}
    return $t
}
puts [total 5 6]} answers {args} extra {list rest all} out {11} why {A final parameter named `args` gathers the remaining arguments into a list.}}
  {kind type q {What is the name of the special parameter that collects extra arguments?} accept {args} why {`args`.}}
  {kind code prompt {Write a proc **greet** with an optional name. `greet` returns `Hello, world!` and `greet Ada` returns `Hello, Ada!`.} starter {proc greet {} {
    return "Hello, world!"
}} solution {proc greet {{name world}} {
    return "Hello, $name!"
}} tests {{greet} {Hello, world!} {greet Ada} {Hello, Ada!}} why {Use `{name world}` to give the parameter a default value.}}
}
cards {
  {{How do you give a parameter a default value?} {Write it as a pair in braces: `proc greet {{name "friend"}} {...}`.}}
  {{What does the parameter `args` do?} {It collects all remaining arguments into a list, so a proc can take any number of values.}}
  {{How do you leave a proc early?} {Use `return` - it exits immediately, even inside a loop.}}
  {{How can a proc give back two values?} {Return a list: `return [list $a $b]`.}}
}
}

content::lesson 5.3 5 "Scope and recursion" "Which variables a proc can see - and procs that call themselves." {
pages {
  {head "Local variables" body {
    p {Variables created inside a proc are **local**: they exist only while the proc runs, and they cannot be seen outside. Likewise the proc cannot see your outside variables by default.}
    code {set x 10
proc f {} {
    set x 99
    return $x
}
puts [f]
puts $x}
    out {99
10}
    p {This is a feature: a proc cannot accidentally break variables elsewhere.}
  }}
  {head "global" body {
    p {Sometimes a proc really needs a variable from the outside. The `global` command links to it.}
    code {set count 0
proc bump {} {
    global count
    incr count
}
bump
bump
puts $count}
    out {2}
    tip {Prefer parameters and `return` to globals. They make procs easier to understand and test.}
  }}
  {head "Procs that call themselves" body {
    p {A **recursive** proc solves a problem by calling itself on a smaller one. It needs a **base case** that stops the chain.}
    code {proc fact {n} {
    if {$n <= 1} {return 1}
    return [expr {$n * [fact [expr {$n - 1}]]}]
}
puts [fact 5]}
    out {120}
    p {`fact 5` is 5 times `fact 4`, which is 4 times `fact 3`... down to `fact 1`, the base case.}
  }}
}
ex {
  {kind predict code {set x 1
proc f {} {
    set x 2
}
f
puts $x} choices {1 2 x {}} ans 0 why {The `x` inside `f` is a different, local variable.}}
  {kind predict code {set n 0
proc add {} {
    global n
    incr n 5
}
add
add
puts $n} choices {10 5 0 2} ans 0 why {`global n` makes the proc use the outside variable, so both calls change it.}}
  {kind predict code {proc fact {n} {
    if {$n <= 1} {return 1}
    return [expr {$n * [fact [expr {$n - 1}]]}]
}
puts [fact 4]} choices {24 10 16 4} ans 0 why {4 * 3 * 2 * 1 = 24.}}
  {kind predict code {proc sumto {n} {
    if {$n == 0} {return 0}
    return [expr {$n + [sumto [expr {$n - 1}]]}]
}
puts [sumto 4]} choices {10 4 24 0} ans 0 why {4 + 3 + 2 + 1 + 0 = 10.}}
  {kind mc q {What does a recursive procedure need to stop?} choices {{A base case that does not call itself} {A global variable} {A semicolon} {A loop}} ans 0 why {Without a base case, the proc would call itself forever.}}
  {kind blank q {Let the proc change the outside variable total.} code {set total 0
proc addten {} {
    ___ total
    incr total 10
}
addten
puts $total} answers {global} extra {local upvar set} out {10} why {`global` links the name inside the proc to the global variable.}}
  {kind type q {Which command lets a proc use a variable from outside it?} accept {global} why {`global name`. (`upvar` is the more general version - you will meet it later.)}}
  {kind code prompt {Write a recursive proc **power2** where `power2 n` returns 2 to the power n (assume n is 0 or more).} starter {proc power2 {n} {
    # base case: power2 0 is 1
}} solution {proc power2 {n} {
    if {$n == 0} {return 1}
    return [expr {2 * [power2 [expr {$n - 1}]]}]
}} tests {{power2 0} 1 {power2 1} 2 {power2 10} 1024} why {2 to the n is 2 times 2 to the n-1, and the base case is 1.}}
}
cards {
  {{Where are variables created inside a proc visible?} {Only inside that proc, while it runs (local scope).}}
  {{How does a proc use a variable from outside?} {`global name` inside the proc.}}
  {{What are the two parts of a recursive proc?} {A base case that returns directly, and a step that calls itself on a smaller problem.}}
  {{What does `fact 5` calculate?} {5 x 4 x 3 x 2 x 1 = 120 (the factorial).}}
}
}
} content/u06.tcl {content::unit 6 "Lists" "Tcl's workhorse data structure: ordered collections of things." "#FB923C"

content::lesson 6.1 6 "Lists: ordered collections" "Create lists, read items, grow and change them." {
pages {
  {head "A list of things" body {
    p {A **list** is an ordered collection of items. In Tcl a simple list is just words separated by spaces. Counting starts at **0**, and `end` means the last item.}
    code {set colors {red green blue}
puts [llength $colors]
puts [lindex $colors 0]
puts [lindex $colors end]}
    out {3
red
blue}
    p {- `llength` counts the items
- `lindex list n` fetches item number n}
    tip {Starting at 0 feels odd at first. Think of the index as "how many items to skip".}
  }}
  {head "Growing and changing" body {
    p {`lappend` adds items to the end of a list variable (no `$` - it takes the name). `lrange` takes a slice, and `lset` replaces one item.}
    code {set l {}
lappend l apple
lappend l pear fig
puts $l
puts [lrange $l 1 end]
lset l 0 kiwi
puts $l}
    out {apple pear fig
pear fig
kiwi pear fig}
    p {`{}` is the empty list. `linsert` and `lreplace` insert and replace in the middle.}
  }}
  {head "Building lists with list" body {
    p {To build a list from separate values, use `list`. It looks after the quoting for you, even for items that contain spaces.}
    code {set items [list "red apple" banana]
puts [llength $items]
puts [lindex $items 0]}
    out {2
red apple}
    warn {`{red apple banana}` is a list of **three** items. Use `list "red apple" banana` when an item contains a space.}
  }}
}
ex {
  {kind predict code {set l {a b c d}
puts [lindex $l 1]} choices {b a c d} ans 0 why {Index 0 is `a`, so index 1 is `b`.}}
  {kind predict code {puts [lindex {x y z} end]} choices {z x y end} ans 0 why {`end` means the last item.}}
  {kind predict code {puts [llength {one two three four}]} choices {4 3 5 1} ans 0 why {There are four items.}}
  {kind predict code {set n {}
lappend n 5
lappend n 6 7
puts $n} choices {{5 6 7} {5} {{5 6 7}} {7 6 5}} ans 0 why {`lappend` adds items to the end; the list becomes 5 6 7.}}
  {kind predict code {puts [lrange {a b c d e} 1 3]} choices {{b c d} {a b c} {b c d e} {c d}} ans 0 why {`lrange l 1 3` gives items 1 to 3 inclusive.}}
  {kind predict code {set l {1 2 3}
lset l 1 99
puts $l} choices {{1 99 3} {99 2 3} {1 2 99} {1 2 3 99}} ans 0 why {`lset` replaces item number 1 (the second one).}}
  {kind predict code {puts [llength [list "red apple" banana]]} choices {2 3 1 4} ans 0 why {`list` keeps "red apple" together as one item.}}
  {kind blank q {Get the third item.} code {puts [___ {a b c d} 2]} answers {lindex} extra {lrange llength lappend} out {c} why {`lindex list n` returns item n, counting from 0.}}
  {kind type q {Which command adds an item to the end of a list variable?} accept {lappend} why {`lappend name item`.}}
  {kind code prompt {Write a proc **second** that returns the second item of a list.} starter {proc second {l} {
    return
}} solution {proc second {l} {
    return [lindex $l 1]
}} tests {{second {a b c}} b {second {10 20}} 20} why {The second item has index 1.}}
}
cards {
  {{How do you get the number of items in a list?} {`llength $list`}}
  {{How do you read item number 2 (counting from 0)?} {`lindex $list 2` - and `lindex $list end` for the last one.}}
  {{How do you add an item to the end of a list variable?} {`lappend name item` (no dollar sign before the name).}}
  {{Why use `list` to build a list?} {It quotes items correctly, so values with spaces stay as one item.}}
}
}

content::lesson 6.2 6 "Searching, sorting and joining" "Find things, put them in order, and convert between lists and text." {
pages {
  {head "Finding items" body {
    p {`lsearch` returns the index of the first matching item, or `-1` if there is none. `lsearch -all` returns every matching index. And `in` is a quick yes/no test.}
    code {set l {apple pear fig pear}
puts [lsearch $l fig]
puts [lsearch $l kiwi]
puts [lsearch -all $l pear]
puts [expr {"fig" in $l}]}
    out {2
-1
1 3
1}
    p {By default `lsearch` uses **glob** patterns: `lsearch $l p*` finds the first item starting with p. Add `-exact` to match literally.}
  }}
  {head "Sorting" body {
    p {`lsort` returns a sorted copy. By default it sorts alphabetically, so numbers need `-integer` (or `-real`).}
    code {puts [lsort {pear apple fig}]
puts [lsort -integer {10 9 100 1}]
puts [lsort -integer -decreasing {10 9 100 1}]}
    out {apple fig pear
1 9 10 100
100 10 9 1}
    warn {Without `-integer`, the numbers are sorted as text: `1 10 100 9`.}
    p {`lreverse` flips a list. `lsort -unique` also removes duplicates.}
  }}
  {head "Lists and text" body {
    p {`split` cuts text into a list at a separator; `join` glues a list back into text.}
    code {set parts [split "2024-05-17" -]
puts [lindex $parts 1]
puts [join {a b c} " + "]
puts [llength [split "a,b,,c" ,]]}
    out {05
a + b + c
4}
    p {Notice the empty item between the two commas - `split` keeps it. `concat` joins lists into one longer list.}
  }}
}
ex {
  {kind predict code {puts [lsearch {a b c} c]} choices {2 3 c 1} ans 0 why {`c` is at index 2.}}
  {kind predict code {puts [lsearch {a b c} z]} choices {-1 0 {} z} ans 0 why {No match gives -1.}}
  {kind predict code {puts [lsort {pear apple fig}]} choices {{apple fig pear} {pear fig apple} {fig apple pear} {apple pear fig}} ans 0 why {Alphabetical order.}}
  {kind predict code {puts [lsort {10 9 100 1}]} choices {{1 10 100 9} {1 9 10 100} {100 10 9 1} {9 10 100 1}} ans 0 why {Without `-integer` the items are compared as text, character by character.}}
  {kind predict code {puts [lsort -integer -decreasing {5 50 7}]} choices {{50 7 5} {5 7 50} {7 5 50} {50 5 7}} ans 0 why {Largest first.}}
  {kind predict code {puts [join {x y z} -]} choices {x-y-z {x - y - z} xyz {x y z}} ans 0 why {`join` places the separator between items.}}
  {kind predict code {puts [lindex [split "a:b:c" :] 2]} choices {c b a {a:b:c}} ans 0 why {`split` gives {a b c}; index 2 is `c`.}}
  {kind predict code {puts [lreverse {1 2 3}]} choices {{3 2 1} {1 2 3} {2 1 3} {3 1 2}} ans 0 why {`lreverse` flips the order.}}
  {kind blank q {Sort the numbers from smallest to largest.} code {puts [lsort ___ {30 4 200}]} answers {-integer} extra {-text -decreasing -unique} out {4 30 200} why {`-integer` compares the items as numbers.}}
  {kind type q {What does lsearch return when nothing matches?} accept {-1} why {-1.}}
  {kind code prompt {Write a proc **csvsum** that takes comma-separated numbers like `3,4,5` and returns their sum.} starter {proc csvsum {text} {
    set total 0
    return $total
}} solution {proc csvsum {text} {
    set total 0
    foreach n [split $text ,] {incr total $n}
    return $total
}} tests {{csvsum 3,4,5} 12 {csvsum 10} 10} why {`split` turns the text into a list, `foreach` adds up the items.}}
}
cards {
  {{What does `lsearch $l x` return?} {The index of the first item matching x, or -1 if there is none.}}
  {{How do you sort numbers properly?} {`lsort -integer $list` (or `-real`). Plain `lsort` sorts as text, so 10 comes before 9.}}
  {{What do `split` and `join` do?} {`split text sep` makes a list from text; `join list sep` makes text from a list.}}
  {{How do you test membership in a list?} {`expr {$x in $list}` returns 1 or 0.}}
}
}

content::lesson 6.3 6 "More list power" "Transform lists, unpack them, nest them and spread them out." {
pages {
  {head "lmap - transform a list" body {
    p {`lmap` is like `foreach`, but it **collects** the results into a new list.}
    code {puts [lmap n {1 2 3 4} {expr {$n * 10}}]}
    out {10 20 30 40}
    p {Use `continue` to filter: items for which the body continues are left out.}
    code {puts [lmap n {1 2 3 4 5 6} {
    if {$n % 2} continue
    set n
}]}
    out {2 4 6}
    p {Here odd numbers are skipped, and `set n` as the last command produces each kept value.}
  }}
  {head "Unpacking and nesting" body {
    p {`lassign` splits a list into separate variables. A list can also contain lists, which is how tables are stored.}
    code {lassign {Ada 36} name age
puts "$name is $age"
set table {{Ann 31} {Bob 25} {Cy 40}}
puts [lindex $table 1 0]
puts [lsort -integer -index 1 $table]}
    out {Ada is 36
Bob
{Bob 25} {Ann 31} {Cy 40}}
    p {`lindex $table 1 0` means "item 1, then item 0 of that". `lsort -index 1` sorts the rows by their second column.}
  }}
  {head "Spreading with {*}" body {
    p {Put `{*}` in front of a list to spread its items out as separate arguments.}
    code {set nums {3 9 5}
puts [tcl::mathfunc::max {*}$nums]
set more {7 8}
lappend nums {*}$more
puts $nums}
    out {9
3 9 5 7 8}
    p {Maths functions such as `max` are really commands in the `tcl::mathfunc` namespace, which is why they can be called directly like this.}
    tip {Without the expansion, `lappend nums $more` would add one item that is itself a list.}
  }}
}
ex {
  {kind predict code {puts [lmap x {1 2 3} {expr {$x * $x}}]} choices {{1 4 9} {1 2 3} {2 4 6} {3 6 9}} ans 0 why {`lmap` collects the result of each round into a new list.}}
  {kind predict code {lassign {red green} a b
puts $b} choices {green red {red green} {}} ans 0 why {`lassign` puts the first item in `a` and the second in `b`.}}
  {kind predict code {set t {{a 1} {b 2}}
puts [lindex $t 1 0]} choices {b a 2 1} ans 0 why {Row 1 is `b 2`, and its item 0 is `b`.}}
  {kind predict code {puts [lmap w {apple fig kiwi} {string length $w}]} choices {{5 3 4} {3 5 4} {5 4 3} {apple fig kiwi}} ans 0 why {Each word is replaced by its length.}}
  {kind predict code {set l {1 2}
lappend l {*}{3 4}
puts [llength $l]} choices {4 3 2 5} ans 0 why {`{*}` spreads 3 and 4 as separate items, so the list has four items.}}
  {kind predict code {puts [lsort -integer -index 1 {{a 9} {b 2} {c 5}}]} choices {{{b 2} {c 5} {a 9}} {{a 9} {b 2} {c 5}} {{c 5} {b 2} {a 9}} {{b 2} {a 9} {c 5}}} ans 0 why {The rows are ordered by their second column: 2, 5, 9.}}
  {kind mc q {What is the difference between `foreach` and `lmap`?} choices {{`lmap` collects the results into a new list} {`foreach` is faster} {`lmap` only works on numbers} {There is none}} ans 0 why {`foreach` just runs code; `lmap` returns a list of the results.}}
  {kind blank q {Spread the list as separate arguments.} code {set n {4 8 6}
puts [tcl::mathfunc::max ___$n]} answers {{{*}}} extra {{...} {@} {&}} out {8} why {`{*}$n` expands the list into separate words.}}
  {kind code prompt {Write a proc **evens** that returns only the even numbers of a list, using lmap.} starter {proc evens {l} {
    return $l
}} solution {proc evens {l} {
    return [lmap n $l {if {$n % 2} continue; set n}]
}} tests {{evens {1 2 3 4 5 6}} {2 4 6} {evens {7 9}} {}} why {`continue` skips odd numbers, and `set n` gives the value to keep.}}
}
cards {
  {{What does `lmap` do?} {Like foreach, but collects each round's result into a new list.}}
  {{What does `lassign {a b} x y` do?} {Puts a in x and b in y.}}
  {{What does `{*}$list` do?} {Spreads the items of the list as separate arguments.}}
  {{How do you read row 1, column 0 of a nested list?} {`lindex $table 1 0`}}
}
}
} content/u07.tcl {content::unit 7 "Strings and patterns" "Slice, search, format and transform text - Tcl's home turf." "#F472B6"

content::lesson 7.1 7 "The string toolkit" "A family of commands for looking at and changing text." {
pages {
  {head "Looking inside text" body {
    p {All text tools live under one command, `string`, followed by what to do. Positions start at 0 and `end` means the last character.}
    code {set s "Hello, Tcl"
puts [string length $s]
puts [string index $s 0]
puts [string range $s 7 end]
puts [string first "," $s]}
    out {10
H
Tcl
5}
    p {`string first` returns where a piece of text first occurs (or -1); `string last` finds the final one.}
  }}
  {head "Changing text" body {
    p {These return a **new** string - the original is untouched.}
    code {puts [string toupper "tcl"]
puts [string trim "   hi   "]
puts [string repeat "ab" 3]
puts [string reverse "stressed"]
puts [string map {cat dog} "the cat sat"]}
    out {TCL
hi
ababab
desserts
the dog sat}
    p {`string map` replaces several things at once: give it a list of `old new old new ...` pairs.}
  }}
  {head "Comparing and testing" body {
    p {`string equal` compares text, `string match` matches a **glob** pattern (`*` any characters, `?` one character), and `string is` checks what kind of thing a value is.}
    code {puts [string equal abc abc]
puts [string match "h*o" hello]
puts [string is integer -strict 42]
puts [string is integer -strict 4x2]}
    out {1
1
1
0}
    tip {`string is` also knows `double`, `alpha`, `alnum`, `space`, `upper`, `lower` and more. Always add `-strict` so an empty string is not counted as valid.}
  }}
}
ex {
  {kind predict code {puts [string length "Tcl is fun"]} choices {10 8 9 3} ans 0 why {Count the characters including both spaces: T-c-l, space, i-s, space, f-u-n = 10.}}
  {kind predict code {puts [string range "abcdef" 1 3]} choices {bcd abc bcde cde} ans 0 why {Positions 1 to 3 inclusive.}}
  {kind predict code {puts [string index "hello" end]} choices {o h l e} ans 0 why {`end` is the last position.}}
  {kind predict code {puts [string first "l" "hello"]} choices {2 3 1 -1} ans 0 why {The first `l` is at position 2.}}
  {kind predict code {puts [string map {a 1 b 2} "abcab"]} choices {12c12 abcab 12cab 1b2} ans 0 why {Every `a` becomes 1 and every `b` becomes 2.}}
  {kind predict code {puts [string trim "  x  "]} choices {x {  x} {x  } {  x  }} ans 0 why {`trim` removes whitespace from both ends.}}
  {kind predict code {puts [string match "*.txt" "notes.txt"]} choices {1 0 notes .txt} ans 0 why {`*` matches any characters, so the name ends in .txt.}}
  {kind predict code {puts [string is integer -strict "12a"]} choices {0 1 12 a} ans 0 why {"12a" contains a letter, so it is not an integer.}}
  {kind blank q {Make it all capital letters.} code {puts [string ___ "quiet"]} answers {toupper} extra {tolower totitle trim} out {QUIET} why {`string toupper` returns an uppercase copy.}}
  {kind type q {Which `string` subcommand gives the number of characters?} accept {length} why {`string length`.}}
  {kind code prompt {Write a proc **initial** that returns the first letter of a word in capitals, e.g. `initial tcl` gives `T`.} starter {proc initial {w} {
    return $w
}} solution {proc initial {w} {
    return [string toupper [string index $w 0]]
}} tests {{initial tcl} T {initial ada} A} why {Take character 0 with `string index`, then pass it to `string toupper`.}}
}
cards {
  {{How do you get part of a string?} {`string range $s first last` (positions start at 0; `end` is the last).}}
  {{What does `string map {a 1 b 2} $s` do?} {Replaces every a with 1 and every b with 2.}}
  {{How do you test if text matches a pattern like *.txt?} {`string match "*.txt" $name`}}
  {{How do you check whether text is a number?} {`string is integer -strict $x` (or `double`).}}
}
}

content::lesson 7.2 7 "format and scan" "Build neat text from values, and pull values out of text." {
pages {
  {head "format fills a template" body {
    p {`format` takes a template with **placeholders** and fills them in. `%s` is text, `%d` a whole number, `%f` a decimal number.}
    code {puts [format "%s is %d years old" Ada 36]
puts [format "%.2f" 3.14159]
puts [format "%05d" 42]
puts [format "%x" 255]}
    out {Ada is 36 years old
3.14
00042
ff}
    p {`%.2f` means two digits after the point; `%05d` pads with zeros to width 5; `%x` shows hexadecimal.}
  }}
  {head "Widths and alignment" body {
    p {A number before the letter sets a minimum width. A minus sign aligns left. This lets you print tidy tables.}
    code {foreach {name price} {apple 1.5 melon 12.25} {
    puts [format "%-8s %6.2f" $name $price]
}}
    out {apple      1.50
melon     12.25}
    p {To print a literal percent sign write `%%`.}
    tip {Use `format` whenever you want control of the layout: money with two decimals, aligned columns, zero-padded numbers.}
  }}
  {head "scan - the reverse" body {
    p {`scan` reads values out of text following a template. It returns how many values it found.}
    code {scan "age: 36" "age: %d" age
puts $age
scan "#ff8000" "#%2x%2x%2x" r g b
puts "$r $g $b"}
    out {36
255 128 0}
    p {Great for taking apart fixed-format text such as dates, colours or log lines. For flexible patterns, regular expressions (next lesson) are more powerful.}
  }}
}
ex {
  {kind predict code {puts [format "%d items" 3]} choices {{3 items} {%d items} {3} {items 3}} ans 0 why {`%d` is replaced by 3.}}
  {kind predict code {puts [format "%.1f" 2.75]} choices {2.8 2.7 2.75 3} ans 0 why {One decimal place; 2.75 rounds to 2.8.}}
  {kind predict code {puts [format "%03d" 7]} choices {007 7 070 {  7}} ans 0 why {Zero padded to width 3.}}
  {kind predict code {puts [format "%5s|" ab]} choices {{   ab|} {ab   |} {ab|} {5ab|}} ans 0 why {Width 5, right-aligned by default.}}
  {kind predict code {puts [format "%-5s|" ab]} choices {{ab   |} {   ab|} {ab|} {-5ab|}} ans 0 why {The minus flag left-aligns.}}
  {kind predict code {puts [format "%s has %d%%" Ann 90]} choices {{Ann has 90%} {Ann has 90} {Ann has 90%%} {Ann has %}} ans 0 why {`%%` prints one percent sign.}}
  {kind predict code {scan "7 apples" "%d %s" n w
puts "$w:$n"} choices {apples:7 7:apples {7 apples} n:w} ans 0 why {`scan` stored 7 in n and apples in w.}}
  {kind blank q {Print the value with exactly two decimals.} code {puts [format "___" 2.5]} answers {%.2f} extra {%d %s %2f} out {2.50} why {`%.2f` shows two decimal places.}}
  {kind type q {Which placeholder inserts a whole number in format?} accept {%d} why {`%d`.}}
  {kind code prompt {Write a proc **money** that formats a number with two decimals and a dollar sign: `money 5` gives `$5.00`.} starter {proc money {x} {
    return $x
}} solution {proc money {x} {
    return [format {$%.2f} $x]
}} tests {{money 5} {$5.00} {money 3.456} {$3.46}} why {Use braces so the dollar sign stays literal: `format {$%.2f} $x`.}}
}
cards {
  {{What do %s, %d and %f mean in format?} {Text, whole number, decimal number.}}
  {{How do you show two decimals?} {`format "%.2f" $x`}}
  {{What does the minus in `%-8s` do?} {Left-aligns the text in a field 8 characters wide.}}
  {{What does `scan` do?} {Reads values out of text following a template, like `scan "age: 36" "age: %d" age`.}}
}
}

content::lesson 7.3 7 "Regular expressions" "A tiny language for describing patterns in text." {
pages {
  {head "Describing patterns" body {
    p {A **regular expression** (regex) describes a pattern of text. `regexp pattern string` returns 1 if the pattern is found, 0 otherwise.}
    p {- `.` any one character
- `\d` a digit, `\w` a letter/digit/underscore, `\s` a space
- `+` one or more, `*` zero or more, `?` optional
- `^` start of text, `$` end of text
- `[abc]` one of these characters, `a|b` a or b}
    code {puts [regexp {\d+} "room 42"]
puts [regexp {^\d+$} "42a"]
puts [regexp {colou?r} "my color"]}
    out {1
0
1}
    tip {Write patterns in **curly braces**, so Tcl leaves the backslashes alone for the regex engine.}
  }}
  {head "Capturing parts" body {
    p {Round brackets **capture** the part they match. After the string, list variables to receive the whole match followed by each capture.}
    code {regexp {(\d+)-(\d+)} "call 555-1234" all area num
puts "$all / $area / $num"}
    out {555-1234 / 555 / 1234}
    p {With `-all -inline` you get every match as a list:}
    code {puts [regexp -all -inline {\d+} "a1 b22 c333"]}
    out {1 22 333}
  }}
  {head "Replacing text" body {
    p {`regsub` replaces matches. Use `-all` to replace every match instead of only the first. In the replacement, `\1`, `\2` ... refer to the captures.}
    code {puts [regsub -all {\s+} "a   b    c" " "]
puts [regsub {(\w+) (\w+)} "hello world" {\2 \1}]}
    out {a b c
world hello}
    p {Add `-nocase` to ignore capital letters. Regular expressions take time to learn, but one line can replace pages of code.}
  }}
}
ex {
  {kind predict code {puts [regexp {\d} "abc"]} choices {0 1 abc {}} ans 0 why {There is no digit in "abc".}}
  {kind predict code {puts [regexp {^a.*z$} "abcxyz"]} choices {1 0 abcxyz a} ans 0 why {Starts with a, ends with z, anything in between.}}
  {kind predict code {regexp {(\w+)@(\w+)} "mail ann@site now" all user host
puts "$user at $host"} choices {{ann at site} {ann@site at now} {mail at ann} {all at user}} ans 0 why {The two captures are the word before and after the @.}}
  {kind predict code {puts [regexp -all -inline {[aeiou]} "banana"]} choices {{a a a} {b n n} {a n a} {banana}} ans 0 why {Every vowel match is collected into a list.}}
  {kind predict code {puts [regsub -all {a} "banana" "o"]} choices {bonono banana bonana ooooo} ans 0 why {Every `a` is replaced.}}
  {kind predict code {puts [regsub {\d+} "order 66 and 77" "N"]} choices {{order N and 77} {order N and N} {order 66 and 77} {N}} ans 0 why {Without `-all` only the first match is replaced.}}
  {kind mc q {Why write regex patterns in curly braces?} choices {{So Tcl does not process the backslashes first} {It makes them run faster} {Because regexp requires it} {To make them case-insensitive}} ans 0 why {Braces pass the pattern to the regex engine untouched.}}
  {kind blank q {Match one or more digits.} code {puts [regexp {___} "id 123"]} answers {\d+} extra {\w* \s+ .} out {1} why {`\d` is a digit and `+` means one or more.}}
  {kind type q {Which command replaces text that matches a pattern?} accept {regsub} why {`regsub`.}}
  {kind code prompt {Write a proc **digits** that returns only the digits found in a string, joined together: `digits a1b22c3` gives `1223`.} starter {proc digits {s} {
    return $s
}} solution {proc digits {s} {
    return [regsub -all {\D} $s ""]
}} tests {{digits a1b22c3} 1223 {digits none} {}} why {`\D` means "not a digit", so removing every `\D` leaves only digits.}}
}
cards {
  {{What do \d, \w, \s mean in a regex?} {A digit, a word character (letter, digit, underscore), and a whitespace character.}}
  {{How do you capture parts of a match?} {Use round brackets and variable names: `regexp {(\d+)-(\d+)} $s all a b`.}}
  {{How do you replace every match?} {`regsub -all pattern string replacement`}}
  {{Why put regex patterns in braces?} {So Tcl does not interpret the backslashes before the regex engine sees them.}}
}
}
} content/u08.tcl {content::unit 8 "Dictionaries and arrays" "Look things up by name: Tcl's key-value data structures." "#C084FC"

content::lesson 8.1 8 "Dictionaries" "Store values under names, like a tiny database." {
pages {
  {head "Keys and values" body {
    p {A **dictionary** (dict) stores **values** under **keys**. Instead of "item number 3" you ask for "the value named age".}
    code {set person [dict create name Ada age 36]
puts [dict get $person name]
dict set person city London
puts [dict size $person]
puts [dict exists $person age]}
    out {Ada
3
1}
    p {- `dict get $d key` reads a value
- `dict set d key value` changes or adds (note: variable **name**, no `$`)
- `dict exists $d key` tests for a key
- `dict size $d` counts the entries}
  }}
  {head "Going through a dict" body {
    p {`dict for` visits every key and value, in the order they were added.}
    code {dict for {k v} {a 1 b 2 c 3} {
    puts "$k -> $v"
}}
    out {a -> 1
b -> 2
c -> 3}
    code {set d {x 10 y 20}
puts [dict keys $d]
puts [dict values $d]}
    out {x y
10 20}
  }}
  {head "Counting with dicts" body {
    p {`dict incr` adds to a number stored under a key, and creates it at zero if it is missing. That makes counting things easy:}
    code {set counts {}
foreach w {a b a c a b} {
    dict incr counts $w
}
puts $counts}
    out {a 3 b 2 c 1}
    p {Other useful commands: `dict unset d key` removes a key, `dict merge $a $b` combines two dicts, and `dict lappend d key item` adds to a list stored under a key.}
    tip {A dict is just a list with an even number of items, key then value. That is why you can print one with `puts`.}
  }}
}
ex {
  {kind predict code {set d [dict create a 1 b 2]
puts [dict get $d b]} choices {2 1 b a} ans 0 why {The value stored under key `b` is 2.}}
  {kind predict code {set d {}
dict set d x 5
dict set d y 6
puts [dict size $d]} choices {2 0 5 1} ans 0 why {Two keys were added.}}
  {kind predict code {set d {k 1}
puts [dict exists $d z]} choices {0 1 k {}} ans 0 why {There is no key `z`.}}
  {kind predict code {set c {}
foreach x {p q p} {dict incr c $x}
puts [dict get $c p]} choices {2 1 3 p} ans 0 why {`p` was counted twice.}}
  {kind predict code {set d {a 1 b 2}
dict set d a 9
puts $d} choices {{a 9 b 2} {a 1 b 2} {a 9} {a 1 b 9}} ans 0 why {`dict set` replaces the value of an existing key.}}
  {kind predict code {puts [dict keys {one 1 two 2}]} choices {{one two} {1 2} {one 1} {two one}} ans 0 why {`dict keys` lists the keys.}}
  {kind blank q {Read the value stored under the key colour.} code {set car {colour red wheels 4}
puts [___ get $car colour]} answers {dict} extra {list array string} out {red} why {`dict get dictionary key`.}}
  {kind mc q {Why is `dict set` written without a dollar sign?} choices {{It needs the variable's name, because it changes the variable} {It is a mistake} {Dollar signs are not allowed in dicts} {Only in Tcl 9}} ans 0 why {Like `append`, `lappend` and `incr`, `dict set` modifies a variable so it needs the name.}}
  {kind type q {Which command visits every key and value in a dict?} accept {dict for} why {`dict for {k v} $d {...}`.}}
  {kind code prompt {Write a proc **tally** that takes a list of words and returns a dict of how many times each appears.} starter {proc tally {words} {
    set counts {}
    return $counts
}} solution {proc tally {words} {
    set counts {}
    foreach w $words {dict incr counts $w}
    return $counts
}} tests {{tally {a b a}} {a 2 b 1} {tally {}} {}} why {`dict incr` creates the key at zero if needed, so each word is simply incremented.}}
}
cards {
  {{What is a dict?} {A collection of values stored under keys: `dict create name Ada age 36`.}}
  {{How do you read, add and test keys?} {`dict get $d k`, `dict set d k v`, `dict exists $d k`.}}
  {{How do you loop over a dict?} {`dict for {k v} $d {...}`}}
  {{What does `dict incr counts $word` do?} {Adds 1 to the count stored under that key, starting from 0 if it does not exist.}}
}
}

content::lesson 8.2 8 "Nested data and transformations" "Dicts inside dicts, and ways to reshape them." {
pages {
  {head "Dicts inside dicts" body {
    p {A value can be another dict. Give `dict set` and `dict get` a **path** of keys to reach inside.}
    code {set db {}
dict set db ada age 36
dict set db ada lang Tcl
dict set db bob age 25
puts [dict get $db ada lang]
puts [dict keys $db]
puts $db}
    out {Tcl
ada bob
ada {age 36 lang Tcl} bob {age 25}}
    p {This is how Tcl programs hold records: a dict of users, each user a dict of fields.}
  }}
  {head "map, filter and with" body {
    p {`dict map` builds a new dict by running code on each value. `dict filter` keeps entries that pass a test.}
    code {set stock {apple 3 pear 0 fig 7}
puts [dict map {k v} $stock {expr {$v * 10}}]
puts [dict filter $stock script {k v} {expr {$v > 0}}]}
    out {apple 30 pear 0 fig 70
apple 3 fig 7}
    p {`dict with` temporarily turns every key into a variable, which is handy for working with a record:}
    code {set user {name Ada age 36}
dict with user {
    puts "$name is $age"
    incr age
}
puts $user}
    out {Ada is 36
name Ada age 37}
  }}
  {head "Sorted output" body {
    p {A dict remembers the order keys were added. To print it in alphabetical order, sort the keys first.}
    code {set d {pear 2 apple 5 fig 1}
foreach k [lsort [dict keys $d]] {
    puts "$k=[dict get $d $k]"
}}
    out {apple=5
fig=1
pear=2}
    tip {Work out how your data is shaped first - "a list of records" or "a dict of records" - and the code usually falls into place.}
  }}
}
ex {
  {kind predict code {set db {}
dict set db ann age 31
puts [dict get $db ann age]} choices {31 ann age {age 31}} ans 0 why {A key path reaches inside the nested dict.}}
  {kind predict code {set d {a 1 b 2}
puts [dict map {k v} $d {expr {$v + 100}}]} choices {{a 101 b 102} {101 102} {a 1 b 2} {a 100 b 100}} ans 0 why {`dict map` keeps the keys and replaces each value with the result.}}
  {kind predict code {puts [dict filter {a 1 b 5 c 9} script {k v} {expr {$v > 3}}]} choices {{b 5 c 9} {a 1} {a 1 b 5} {c 9}} ans 0 why {Only entries whose value is greater than 3 survive.}}
  {kind predict code {set p {x 3 y 4}
dict with p {
    puts [expr {$x * $y}]
}} choices {12 7 {3 4} y} ans 0 why {`dict with` makes `x` and `y` into variables inside the body.}}
  {kind predict code {set d {b 2 a 1}
foreach k [lsort [dict keys $d]] {puts $k}} choices {"a\nb" "b\na" "1\n2" "ab"} ans 0 why {Sorted keys give a, then b.}}
  {kind mc q {How would you store several users, each with a name and an age?} choices {{A dict whose values are dicts} {One long string} {Several unrelated variables} {A single number}} ans 0 why {Nested dicts - the key is the user and the value is the record - model this naturally.}}
  {kind blank q {Keep only the entries whose value is above zero.} code {puts [dict ___ {a 0 b 2} script {k v} {expr {$v > 0}}]} answers {filter} extra {map with get} out {b 2} why {`dict filter` returns the entries that pass the test.}}
  {kind type q {Which command turns the keys of a dict into variables inside a body?} accept {dict with} why {`dict with`.}}
  {kind code prompt {Write a proc **oldest** that takes a dict mapping names to ages and returns the name with the highest age.} starter {proc oldest {people} {
    return
}} solution {proc oldest {people} {
    set best ""
    set max -1
    dict for {name age} $people {
        if {$age > $max} {set max $age; set best $name}
    }
    return $best
}} tests {{oldest {ann 31 bob 25 cy 40}} cy {oldest {z 1}} z} why {Remember the highest age so far and the name that goes with it.}}
}
cards {
  {{How do you set and read a value in a nested dict?} {`dict set d outer inner value` and `dict get $d outer inner`.}}
  {{What do `dict map` and `dict filter` do?} {`map` transforms each value into a new dict; `filter` keeps entries that pass a test.}}
  {{What does `dict with` do?} {Makes each key of a dict a variable inside its body, and writes changes back.}}
  {{How do you print a dict sorted by key?} {`foreach k [lsort [dict keys $d]] {...}`}}
}
}

content::lesson 8.3 8 "Arrays" "Tcl's other lookup table - and how to choose." {
pages {
  {head "Variables with slots" body {
    p {An **array** is a variable with many named slots. Write the key in round brackets after the name.}
    code {set price(apple) 3
set price(pear) 5
puts $price(apple)
puts [array size price]
puts [array exists price]
puts [info exists price(fig)]}
    out {3
2
1
0}
    p {An array is **not** a single value: you cannot write `puts $price`. It is a collection of variables sharing a name.}
  }}
  {head "Working with arrays" body {
    p {`array names` lists the keys (in no guaranteed order, so sort them), `array get` converts to a list of key/value pairs, `array set` fills from such a list, and `unset` removes an element.}
    code {array set stock {apple 3 pear 5 fig 1}
foreach k [lsort [array names stock]] {
    puts "$k: $stock($k)"
}
unset stock(pear)
puts [lsort [array names stock]]}
    out {apple: 3
fig: 1
pear: 5
apple fig}
  }}
  {head "Array or dict?" body {
    p {Both map keys to values. Which should you use?}
    p {- A **dict** is a *value*: you can pass it to a proc, return it, nest it, store it in a list and compare it. **Use dicts by default.**
- An **array** is a *variable*: great for a big table that many parts of a program update in place, but it cannot be passed around by value or nested.}
    tip {Older Tcl code uses arrays a lot, so you will meet them often. Reading them is a must; writing new code with dicts is usually nicer.}
  }}
}
ex {
  {kind predict code {set a(x) 10
puts $a(x)} choices {10 x a {a(x)}} ans 0 why {`$a(x)` reads the slot named x.}}
  {kind predict code {set a(p) 1
set a(q) 2
puts [array size a]} choices {2 1 0 3} ans 0 why {The array has two elements.}}
  {kind predict code {array set m {k 5}
puts $m(k)} choices {5 k m {}} ans 0 why {`array set` created the slot `k` with value 5.}}
  {kind predict code {set s(a) 1
puts [info exists s(b)]} choices {0 1 b a} ans 0 why {There is no slot `b`.}}
  {kind predict code {array set d {b 2 a 1 c 3}
puts [lsort [array names d]]} choices {{a b c} {b a c} {1 2 3} {c b a}} ans 0 why {`array names` returns the keys; `lsort` puts them in order.}}
  {kind mc q {Which is true about dicts compared with arrays?} choices {{A dict is a value that can be passed, returned and nested} {Arrays can be returned from procs} {Dicts cannot hold other dicts} {They are the same thing}} ans 0 why {A dict is an ordinary value, so you can use it anywhere a value is allowed.}}
  {kind blank q {Remove the element named b.} code {array set t {a 1 b 2}
___ t(b)
puts [array names t]} answers {unset} extra {delete remove clear} out {a} why {`unset` deletes a variable or an array element.}}
  {kind type q {Which command lists the keys of an array?} accept {array names} why {`array names arrayName`.}}
  {kind code prompt {Write a proc **sumvalues** that takes an array NAME and returns the total of its values. (Hint: use `upvar 1 $name arr` to reach the caller's array.)} starter {proc sumvalues {name} {
    upvar 1 $name arr
    return 0
}} solution {proc sumvalues {name} {
    upvar 1 $name arr
    set t 0
    foreach k [array names arr] {incr t $arr($k)}
    return $t
}} tests {{array set z {a 1 b 2 c 4}; sumvalues z} 7} why {`upvar 1 $name arr` links `arr` to the caller's array; then loop over `array names`.}}
}
cards {
  {{How do you write an array element?} {`set price(apple) 3` and read it with `$price(apple)`.}}
  {{How do you list an array's keys?} {`array names price` - sort them for a stable order.}}
  {{Dict or array - which by default?} {A dict: it is a normal value you can pass, return and nest.}}
  {{How do you delete an array element?} {`unset price(apple)`}}
}
}
} content/u09.tcl {content::unit 9 "Errors and files" "Handle problems gracefully and work with data on disk." "#22D3EE"

content::lesson 9.1 9 "When things go wrong" "Catch errors, raise your own, and clean up afterwards." {
pages {
  {head "Errors stop programs" body {
    p {When a command cannot do its job it raises an **error**. Unless something handles it, the program stops.}
    code {puts [expr {10 / 0}]}
    out {divide by zero}
    p {You can raise your own errors with `error`. This is how a proc says "I was given something I cannot work with".}
    code {proc setAge {n} {
    if {$n < 0} {error "age cannot be negative"}
    return $n
}
setAge -5}
    out {age cannot be negative}
  }}
  {head "catch" body {
    p {`catch {script} ?resultVar?` runs the script and **never** stops the program. It returns `0` when the script worked and `1` when it raised an error. The variable receives the result or the error message.}
    code {if {[catch {expr {10 / 0}} msg]} {
    puts "Oops: $msg"
}
puts [catch {set x 5} r]
puts $r}
    out {Oops: divide by zero
0
5}
  }}
  {head "try and finally" body {
    p {`try` is the tidy modern way. `on error` handles failures, and `finally` runs no matter what - ideal for cleanup like closing files.}
    code {try {
    expr {1 / 0}
} on error {msg} {
    puts "caught: $msg"
} finally {
    puts "done"
}}
    out {caught: divide by zero
done}
    p {You can also react only to a *specific* kind of error with `trap`:}
    code {try {
    expr {1 / 0}
} trap {ARITH DIVZERO} {} {
    puts "division by zero"
}}
    out {division by zero}
    tip {Errors have a machine-readable `-errorcode` list as well as the message. `trap` matches on that, so your handler does not depend on the exact wording.}
  }}
}
ex {
  {kind predict code {puts [catch {expr {4 / 2}} r]
puts $r} choices {"0\n2" "1\n2" "0\n4/2" "2\n0"} ans 0 why {The script worked, so `catch` returns 0 and the variable holds the result, 2.}}
  {kind predict code {puts [catch {error "boom"} m]
puts $m} choices {"1\nboom" "0\nboom" "1\nerror" "boom\n1"} ans 0 why {`error` raises an error, so `catch` returns 1 and `m` holds the message.}}
  {kind predict code {catch {expr {1 / 0}} m
puts $m} choices {{divide by zero} 0 1 {}} ans 0 why {The message of the error is stored in the variable.}}
  {kind predict code {try {
    puts "working"
} finally {
    puts "cleanup"
}} choices {"working\ncleanup" "cleanup\nworking" "working" "cleanup"} ans 0 why {`finally` runs after the body, whether or not an error happened.}}
  {kind predict code {try {
    error "bad"
} on error {m} {
    puts "handled $m"
}
puts "after"} choices {"handled bad\nafter" "after" "handled bad" "bad\nafter"} ans 0 why {The error is handled, so the program carries on.}}
  {kind mc q {What does `catch` return when the script succeeds?} choices {0 1 The result Nothing} ans 0 why {0 means success; 1 means an error was caught.}}
  {kind blank q {Raise an error with a message.} code {catch {___ "oops"} m
puts $m} answers {error} extra {throw fail raise} out {oops} why {`error message` raises an error.}}
  {kind type q {Which block of `try` always runs, whatever happens?} accept {finally} why {`finally`.}}
  {kind code prompt {Write a proc **safediv** that returns `a / b`, or the text `n/a` when the division fails (for example when b is 0).} starter {proc safediv {a b} {
    return [expr {$a / $b}]
}} solution {proc safediv {a b} {
    if {[catch {expr {$a / $b}} r]} {return n/a}
    return $r
}} tests {{safediv 10 2} 5 {safediv 1 0} n/a} why {Wrap the risky `expr` in `catch` and return `n/a` if it reports an error.}}
}
cards {
  {{How do you run code that might fail without stopping the program?} {`if {[catch {script} msg]} {...}` - catch returns 1 on error, and msg holds the message.}}
  {{How do you raise your own error?} {`error "message"`}}
  {{What does `finally` do in try?} {It always runs, error or not - used for cleanup.}}
  {{How do you handle one specific kind of error?} {`try {...} trap {ARITH DIVZERO} {} {...}` matches on the error code.}}
}
}

content::lesson 9.2 9 "Reading and writing files" "Make programs that remember things." {
pages {
  {head "Writing" body {
    p {To use a file you **open** it, get a **channel** (a handle), use it, then **close** it. The second argument says what you want to do: `r` read, `w` write (erases the file), `a` append.}
    code {set f [open "notes.txt" w]
puts $f "line one"
puts $f "line two"
close $f
puts [file exists "notes.txt"]}
    out {1}
    p {`puts` takes an optional channel before the text - the very first thing you learned about it! Without one it uses `stdout`, the screen.}
    tip {In this app, files created in lessons live in a private scratch folder that is wiped between runs, so you can experiment freely.}
  }}
  {head "Reading" body {
    p {`gets $f var` reads one line into a variable and returns its length (or -1 at the end of the file). `read $f` returns the whole file.}
    code {set f [open "notes.txt" w]
puts $f "alpha"
puts $f "beta"
close $f
set f [open "notes.txt" r]
while {[gets $f line] >= 0} {
    puts "got: $line"
}
close $f}
    out {got: alpha
got: beta}
    code {set f [open "notes.txt" r]
set text [read $f]
close $f
puts [llength [split [string trim $text] "\n"]]}
    out {2}
    warn {Always `close` what you `open`, even when something fails. Use `try ... finally { close $f }` to be certain.}
  }}
  {head "Names and paths" body {
    p {The `file` command works with names and the file system, without opening anything. `file join` builds a path correctly for any operating system.}
    code {puts [file join a b "c.txt"]
puts [file extension "report.pdf"]
puts [file tail /usr/lib/libx.so]
puts [file rootname "report.pdf"]
puts [file dirname /usr/lib/libx.so]}
    out {a/b/c.txt
.pdf
libx.so
report
/usr/lib}
    p {Also useful: `file exists`, `file size`, `file delete` and `glob *.txt` (list the files matching a pattern).}
  }}
}
ex {
  {kind predict code {puts [file extension "photo.jpg"]} choices {.jpg jpg photo {photo.}} ans 0 why {`file extension` includes the dot.}}
  {kind predict code {puts [file tail "/home/ann/notes.txt"]} choices {notes.txt /home/ann ann notes} ans 0 why {`file tail` is the last part of the path.}}
  {kind predict code {puts [file join usr local bin]} choices {usr/local/bin {usr local bin} /usr/local/bin usr:local:bin} ans 0 why {`file join` inserts the right separator.}}
  {kind predict code {set f [open "t.txt" w]
puts $f "hello"
close $f
set f [open "t.txt" r]
gets $f line
close $f
puts [string toupper $line]} choices {HELLO hello {} t.txt} ans 0 why {The line written to the file was read back and converted to capitals.}}
  {kind predict code {set f [open "c.txt" w]
puts $f a
puts $f b
puts $f c
close $f
set f [open "c.txt"]
set n 0
while {[gets $f line] >= 0} {incr n}
close $f
puts $n} choices {3 1 0 2} ans 0 why {Three lines were written, so the loop reads three.}}
  {kind mc q {What does opening a file with mode `w` do to an existing file?} choices {{Erases its contents first} {Adds to the end} {Only reads it} {Deletes the file}} ans 0 why {`w` truncates (empties) the file. Use `a` to append.}}
  {kind mc q {Which mode adds new lines to the end of an existing file?} choices {a w r x} ans 0 why {`a` is for append.}}
  {kind blank q {Close the file when done.} code {set f [open "x.txt" w]
puts $f hi
___ $f
puts [file size "x.txt"]} answers {close} extra {end stop done} out {3} why {`close` flushes the data to disk and releases the file. The file holds `hi` plus a newline: 3 bytes.}}
  {kind type q {Which command reads one line from a channel into a variable?} accept {gets} why {`gets $channel varName`.}}
  {kind code prompt {Write a proc **writelines** that takes a filename and a list, and writes each item on its own line to the file.} starter {proc writelines {name items} {
    # open, write each item, close
}} solution {proc writelines {name items} {
    set f [open $name w]
    foreach i $items {puts $f $i}
    close $f
}} tests {{writelines out.txt {a b c}; set f [open out.txt]; set t [read $f]; close $f; string length $t} 6} why {Open with `w`, `puts $f` for every item, then close.}}
}
cards {
  {{How do you write to a file?} {`set f [open name w]`, then `puts $f text`, then `close $f`.}}
  {{How do you read a file line by line?} {`while {[gets $f line] >= 0} {...}` - gets returns -1 at the end.}}
  {{What are the open modes r, w and a?} {Read, write (erases first), and append.}}
  {{What does `file join a b c.txt` give?} {`a/b/c.txt` - it builds a path with the correct separator.}}
}
}

content::lesson 9.3 9 "A small data pipeline" "Text in, tidy report out - and working with dates." {
pages {
  {head "From text to records" body {
    p {Real programs turn raw text into data. A typical recipe: **split** into lines, **split** each line into fields, **process**, then **format**.}
    code {set data "ann,31,paris
bob,25,rome
cy,40,oslo"
foreach line [split $data "\n"] {
    lassign [split $line ,] name age city
    puts "$name is $age and lives in $city"
}}
    out {ann is 31 and lives in paris
bob is 25 and lives in rome
cy is 40 and lives in oslo}
  }}
  {head "Summaries and reports" body {
    p {Collect the rows into a list, then sort, total and format them.}
    code {set rows {}
foreach line [split "ann,31
bob,25
cy,40" "\n"] {
    lappend rows [split $line ,]
}
set total 0
foreach r [lsort -integer -index 1 $rows] {
    lassign $r name age
    puts [format "%-5s %3d" $name $age]
    incr total $age
}
set avg [expr {double($total) / [llength $rows]}]
puts [format "average: %.1f" $avg]}
    out {bob    25
ann    31
cy     40
average: 32.0}
    tip {`double($total)` makes the division produce a decimal. Without it, 96 / 3 would be a whole-number division.}
  }}
  {head "Dates and times" body {
    p {`clock` handles time. `clock seconds` is the current moment as a count of seconds; `clock format` turns it into readable text; `clock scan` reads text into seconds; `clock add` does calendar arithmetic.}
    code {proc fmt {t} {
    clock format $t -format %Y-%m-%d -timezone :UTC
}
proc parse {s} {
    clock scan $s -format %Y-%m-%d -timezone :UTC
}
puts [fmt 86400]
set t [parse 2024-03-15]
puts [fmt [clock add $t 30 days]]
puts [expr {([parse 2024-03-20] - $t) / 86400}]}
    out {1970-01-02
2024-04-14
5}
    p {Format letters: `%Y` year, `%m` month, `%d` day, `%H:%M:%S` time, `%A` weekday name. Always think about time zones - `:UTC` keeps results the same everywhere.}
  }}
}
ex {
  {kind predict code {lassign [split "x,y,z" ,] a b c
puts $b} choices {y x z {x,y,z}} ans 0 why {`split` makes the list {x y z}; `lassign` puts the second item in `b`.}}
  {kind predict code {puts [llength [split "a b  c" " "]]} choices {4 3 2 5} ans 0 why {`split` keeps the empty item between the two spaces, giving a, b, an empty item, c.}}
  {kind predict code {set total 0
foreach line [split "3\n4\n5" "\n"] {incr total $line}
puts $total} choices {12 345 3 0} ans 0 why {Each line is a number; they sum to 12.}}
  {kind predict code {puts [format "%-4s|%3d" ab 7]} choices {{ab  |  7} {  ab|7  } {ab|7} {ab  |7  }} ans 0 why {Left-aligned text in 4 spaces, then a right-aligned number in 3.}}
  {kind predict code {puts [clock format 0 -format %Y -timezone :UTC]} choices {1970 1900 2000 0} ans 0 why {Second 0 of the clock is the start of 1970 (the "epoch").}}
  {kind predict code {set f %Y-%m-%d
set t [clock scan 2024-01-31 -format $f -timezone :UTC]
set n [clock add $t 1 day]
puts [clock format $n -format $f -timezone :UTC]} choices {2024-02-01 2024-01-32 2024-02-31 2024-01-30} ans 0 why {`clock add` understands calendars: the day after 31 January is 1 February.}}
  {kind mc q {Why write `double($total) / $n` for an average?} choices {{Whole-number division would drop the decimals} {double makes it faster} {It is required syntax} {It rounds the result}} ans 0 why {Making one number a decimal forces a decimal answer.}}
  {kind blank q {Cut the line into fields at the commas.} code {lassign [___ "ann,31" ,] name age
puts "$name/$age"} answers {split} extra {join lindex string} out {ann/31} why {`split text separator`.}}
  {kind code prompt {Write a proc **average** that takes a list of numbers and returns their average as a decimal, e.g. `average {2 4 9}` gives `5.0`.} starter {proc average {nums} {
    return 0
}} solution {proc average {nums} {
    set total 0
    foreach n $nums {incr total $n}
    return [expr {double($total) / [llength $nums]}]
}} tests {{average {2 4 9}} 5.0 {average {10}} 10.0} why {Sum the list, then divide using a decimal so the answer is not truncated.}}
}
cards {
  {{What is the usual text-processing recipe?} {Split into lines, split lines into fields, process, format the output.}}
  {{How do you split text into lines?} {`split $text "\n"`}}
  {{What do `clock format`, `clock scan` and `clock add` do?} {Format seconds as text, read text into seconds, and add calendar units like days.}}
  {{Why use `double($x)` in a division?} {To force a decimal result instead of a whole-number division.}}
}
}
} content/u10.tcl {content::unit 10 "Advanced Tcl" "How Tcl really works - and how to bend it to your will." "#FB7185"

content::lesson 10.1 10 "How Tcl reads code" "The few rules behind everything - and how to build and run code as data." {
pages {
  {head "One pass, left to right" body {
    p {You now know enough to see the whole picture. Tcl reads a command line like this:}
    p {- Split the line into **words**
- In each word, do the substitutions **once**: `$variable`, `[command]` and backslash sequences (not inside braces)
- Run the command with the resulting words}
    code {set a 5
set b {$a}
puts $b
puts "[set a 1] and $a"}
    out {$a
1 and 1}
    p {The text `$a` was **not** substituted a second time when it was printed. Substitution happens exactly once per word. This is why Tcl behaves so predictably.}
  }}
  {head "Running text as code" body {
    p {Because commands are just text, you can build a command in a variable and run it. `eval` runs text as a script; `subst` only performs the substitutions in some text without running a command.}
    code {set cmd {puts "hello from eval"}
eval $cmd
set template {Total: $x}
set x 5
puts [subst $template]}
    out {hello from eval
Total: 5}
    p {You can also **spread** a list as a command with `{*}`, which avoids many `eval` surprises:}
    code {set cmd {puts hi}
{*}$cmd}
    out {hi}
  }}
  {head "Build commands with list" body {
    p {When you assemble a command, use `list` so that every value stays **one word**, whatever characters it contains.}
    code {set name "Ada Lovelace"
set good [list puts "Hi $name"]
eval $good
set bad "puts Hi $name"
catch {eval $bad} err
puts $err}
    out {Hi Ada Lovelace
wrong # args: should be "puts ?-nonewline? ?channelId? string"}
    warn {Building a command by gluing strings makes the data run as code. This is the classic source of bugs - and security holes. `list` quotes each value correctly.}
  }}
}
ex {
  {kind predict code {set x 1
set y {$x}
puts $y} choices {{$x} 1 x {}} ans 0 why {Braces stopped substitution when `y` was set, and substitution does not happen again when it is printed.}}
  {kind predict code {set t {Value is $v}
set v 42
puts [subst $t]} choices {{Value is 42} {Value is $v} {Value is} {42}} ans 0 why {`subst` performs the `$` substitution on the text.}}
  {kind predict code {set c {puts hi}
eval $c} choices {hi {puts hi} {} c} ans 0 why {`eval` runs the text as a Tcl command.}}
  {kind predict code {set words {a b c}
puts [llength $words]
puts [llength [list $words]]} choices {"3\n1" "3\n3" "1\n1" "1\n3"} ans 0 why {`list $words` makes a one-item list whose single item is the whole three-word string.}}
  {kind predict code {set n 3
set cmd [list expr $n * 2]
puts [eval $cmd]} choices {6 {3 * 2} 32 n} ans 0 why {`list` assembled the command `expr 3 * 2`, and `eval` ran it.}}
  {kind mc q {How many times does Tcl substitute `$variable` inside one word?} choices {{Exactly once} {Until nothing is left} {Twice} {Never inside quotes}} ans 0 why {One substitution pass per word - the rule that makes Tcl predictable.}}
  {kind mc q {Why build commands with `list` rather than string concatenation?} choices {{`list` keeps each value as one word, however odd its characters} {`list` runs faster} {Concatenation is not allowed} {`list` adds comments}} ans 0 why {Values with spaces, quotes or brackets cannot change the shape of the command.}}
  {kind blank q {Turn the stored list into a command.} code {set cmd {puts ok}
___$cmd} answers {{{*}}} extra {{eval} {$} {@}} out {ok} why {`{*}$cmd` expands the list into separate words, which then form the command.}}
  {kind type q {Which command performs substitution on text without running it as a script?} accept {subst} why {`subst`.}}
}
cards {
  {{When does Tcl perform substitution?} {Once per word, left to right: `$var`, `[cmd]` and backslashes. Never inside braces.}}
  {{What does `eval` do?} {Runs text as a Tcl script.}}
  {{What does `subst` do?} {Performs variable, command and backslash substitution on text and returns the result.}}
  {{How should you build a command safely?} {With `list`, then run it with `{*}$cmd` or `eval $cmd`.}}
}
}

content::lesson 10.2 10 "upvar and uplevel" "Reach into the caller's world - the trick behind Tcl's control structures." {
pages {
  {head "upvar: link to the caller's variable" body {
    p {A proc normally cannot touch its caller's variables. `upvar` creates a local name that **points at** a variable in the caller. You pass the variable's **name**, just like `incr` and `append` expect.}
    code {proc incr2 {varName} {
    upvar 1 $varName v
    incr v 2
}
set n 10
incr2 n
puts $n}
    out {12}
    p {`upvar 1 $varName v` says: "`v` is another name for the variable called `$varName` one level up (in the caller)". Changing `v` changes the caller's `n`.}
  }}
  {head "Two variables at once" body {
    p {`upvar` can link several names in one go. A classic example is swapping two variables.}
    code {proc swap {a b} {
    upvar 1 $a x $b y
    set t $x
    set x $y
    set y $t
}
set p 1
set q 2
swap p q
puts "$p $q"}
    out {2 1}
    tip {`upvar #0 name local` links to a **global** variable, which is what `global` does.}
  }}
  {head "uplevel: run code in the caller" body {
    p {`uplevel` evaluates a script **in the caller's context**. Together with the fact that braces pass code around as ordinary text, this lets you invent your own control structures.}
    code {proc repeat {n body} {
    for {set i 0} {$i < $n} {incr i} {
        uplevel 1 $body
    }
}
repeat 3 {puts "hello"}}
    out {hello
hello
hello}
    code {proc unless {cond body} {
    uplevel 1 [list if "!($cond)" $body]
}
set n 5
unless {$n > 10} {puts "n is small"}}
    out {n is small}
    p {Neither `repeat` nor `unless` is built into Tcl - you just made them. This is why Tcl needs no special syntax for loops: they are ordinary commands.}
  }}
}
ex {
  {kind predict code {proc bump {name} {
    upvar 1 $name v
    incr v
}
set k 7
bump k
puts $k} choices {8 7 k 1} ans 0 why {`v` is linked to the caller's `k`, so `incr v` changes `k`.}}
  {kind predict code {proc swap {a b} {
    upvar 1 $a x $b y
    set t $x; set x $y; set y $t
}
set u first
set w second
swap u w
puts "$u $w"} choices {{second first} {first second} {u w} {w u}} ans 0 why {The values trade places.}}
  {kind predict code {proc twice {body} {
    uplevel 1 $body
    uplevel 1 $body
}
set c 0
twice {incr c 5}
puts $c} choices {10 5 0 c} ans 0 why {The body runs twice in the caller's scope, so `c` goes 5 then 10.}}
  {kind predict code {proc setit {} {
    uplevel 1 {set hidden 99}
}
setit
puts $hidden} choices {99 hidden {} 1} ans 0 why {`uplevel` ran `set hidden 99` in the caller, so the variable exists there.}}
  {kind mc q {What does `upvar 1 $name v` do?} choices {{Makes v another name for the caller's variable called $name} {Copies the value of name into v} {Creates a global} {Deletes the variable}} ans 0 why {It is a link, not a copy - changes to `v` change the original.}}
  {kind mc q {Why do you pass `n` rather than `$n` to a proc that uses upvar?} choices {{The proc needs the variable's name, not its value} {Dollar signs are slow} {It is required by upvar} {The name is shorter}} ans 0 why {With `$n` you would hand over the value, and there would be nothing to link to.}}
  {kind blank q {Run the body in the caller's scope.} code {proc do {body} {
    ___ 1 $body
}
do {puts "ran"}} answers {uplevel} extra {upvar eval global} out {ran} why {`uplevel` evaluates a script in the caller's context.}}
  {kind type q {Which command links a local name to a variable in the caller?} accept {upvar} why {`upvar`.}}
  {kind code prompt {Write a proc **dbl** that takes the NAME of a variable and doubles its value in the caller.} starter {proc dbl {name} {
    # use upvar
}} solution {proc dbl {name} {
    upvar 1 $name v
    set v [expr {$v * 2}]
}} tests {{set z 21; dbl z; set z} 42} why {Link with `upvar 1 $name v`, then set `v` to double its value.}}
}
cards {
  {{What does `upvar 1 name v` do?} {Makes `v` a local alias for the variable called `name` in the caller's scope.}}
  {{What does `uplevel 1 script` do?} {Runs the script in the caller's context.}}
  {{Why can you write your own control structures in Tcl?} {Braced code is just an argument; `uplevel` can run it in the caller, so commands like `repeat` behave like built-ins.}}
  {{How do you link to a global variable with upvar?} {`upvar #0 name local`}}
}
}

content::lesson 10.3 10 "Functions as data" "Lambdas, callbacks and looking at your own program." {
pages {
  {head "apply and anonymous functions" body {
    p {`apply` runs a **function value**: a list of parameters and a body (and optionally a namespace). It needs no name, so it is perfect for short throwaway functions.}
    code {puts [apply {{x} {expr {$x * 2}}} 21]
set sq {{n} {expr {$n * $n}}}
puts [apply $sq 7]
puts [lmap n {1 2 3} {apply $sq $n}]}
    out {42
49
1 4 9}
    p {Because the function is an ordinary value, you can store it in a variable, put it in a list, and pass it to a proc.}
  }}
  {head "Callbacks: command prefixes" body {
    p {A **command prefix** is a command with some leading arguments already filled in. A proc can take one and add the final argument(s) with `{*}`.}
    code {proc map {cmd list} {
    set r {}
    foreach x $list {lappend r [{*}$cmd $x]}
    return $r
}
puts [map {string toupper} {a b c}]
puts [map {apply {{n} {expr {$n * 3}}}} {1 2 3}]}
    out {A B C
3 6 9}
    p {This pattern is everywhere in Tcl: `after`, `trace`, `bind`, `fileevent`, `lsort -command`... all accept command prefixes.}
  }}
  {head "Looking at your own program" body {
    p {Tcl can inspect itself. `info` tells you about commands, variables and procs - and `rename` can change a command's name.}
    code {proc add {a b} {expr {$a + $b}}
puts [info args add]
puts [info body add]
puts [info exists nothing]
puts [llength [info procs add]]
rename add plus
puts [plus 1 2]}
    out {a b
expr {$a + $b}
0
1
3}
    tip {Because everything is a command, you can wrap or replace any command - even built-in ones - by renaming it and defining a new one in its place.}
  }}
}
ex {
  {kind predict code {puts [apply {{a b} {expr {$a + $b}}} 3 4]} choices {7 12 {3 4} a} ans 0 why {`apply` calls the function value with the arguments 3 and 4.}}
  {kind predict code {set f {{s} {string repeat $s 2}}
puts [apply $f ha]} choices {haha ha {ha ha} s} ans 0 why {The function repeats its argument twice.}}
  {kind predict code {proc each {cmd list} {foreach x $list {{*}$cmd $x}}
each puts {a b}} choices {"a\nb" "a b" "b\na" ""} ans 0 why {The prefix `puts` plus each item makes `puts a` and `puts b`.}}
  {kind predict code {proc greet {name} {return "hi $name"}
puts [info args greet]} choices {name greet hi {}} ans 0 why {`info args` lists the parameter names.}}
  {kind predict code {proc old {} {return 1}
rename old new
puts [new]} choices {1 old new {}} ans 0 why {`rename` changed the command's name but not what it does.}}
  {kind predict code {puts [lmap w {ab abc a} {string length $w}]} choices {{2 3 1} {1 2 3} {3 2 1} {ab abc a}} ans 0 why {Each word is replaced by its length.}}
  {kind mc q {What is a command prefix?} choices {{A command with some leading arguments, to which more are added later} {The first letter of a command} {A comment} {A namespace}} ans 0 why {`{string toupper}` is a prefix; calling `{*}$prefix hello` appends the final argument.}}
  {kind blank q {Call the function value with the argument 5.} code {set sq {{n} {expr {$n * $n}}}
puts [___ $sq 5]} answers {apply} extra {eval call proc} out {25} why {`apply funcValue arg ...`.}}
  {kind type q {Which command lists the parameter names of a proc?} accept {info args} why {`info args procName`.}}
  {kind code prompt {Write a proc **compose** taking two command prefixes f and g and a value x, returning f applied to the result of g applied to x. Example: `compose {string toupper} {string reverse} abc` gives `CBA`.} starter {proc compose {f g x} {
    return $x
}} solution {proc compose {f g x} {
    return [{*}$f [{*}$g $x]]
}} tests {{compose {string toupper} {string reverse} abc} CBA {compose {string length} {string trim} {  hi }} 2} why {Apply g first, then f to that result - each prefix gets its last argument via `{*}`.}}
}
cards {
  {{What does `apply` do?} {Calls a function value `{params body}` with arguments: `apply {{x} {expr {$x * 2}}} 21`.}}
  {{What is a command prefix?} {A command plus leading arguments, to which a caller appends more: `{*}$prefix $extra`.}}
  {{How do you get a proc's parameters or body?} {`info args name` and `info body name`.}}
  {{What does `rename old new` do?} {Gives a command a new name (and `rename old {}` deletes it).}}
}
}

content::lesson 10.4 10 "Namespaces and ensembles" "Organise large programs and build commands with subcommands." {
pages {
  {head "Namespaces" body {
    p {A **namespace** is a named container for commands and variables, preventing clashes in big programs. Refer to its contents with `name::item`.}
    code {namespace eval counter {
    variable n 0
    proc next {} {
        variable n
        return [incr n]
    }
}
puts [counter::next]
puts [counter::next]}
    out {1
2}
    p {`variable` declares a namespace variable, and inside a proc it links the name to the namespace's variable. The global namespace is written `::`.}
  }}
  {head "export and import" body {
    p {A namespace can `export` some commands, and others can `import` them to use the short name.}
    code {namespace eval util {
    namespace export double
    proc double {x} {expr {$x * 2}}
}
namespace import util::double
puts [double 4]
puts [util::double 5]}
    out {8
10}
    tip {Useful helpers: `namespace current` (where am I?), `namespace children`, `namespace which -command name`.}
  }}
  {head "Ensembles" body {
    p {Commands like `string` and `dict` have **subcommands**. `namespace ensemble create` lets you build the same thing: the exported procs of a namespace become its subcommands.}
    code {namespace eval stack {
    variable items {}
    proc push {x} {variable items; lappend items $x}
    proc pop {} {
        variable items
        set x [lindex $items end]
        set items [lrange $items 0 end-1]
        return $x
    }
    proc size {} {variable items; llength $items}
    namespace export push pop size
    namespace ensemble create
}
stack push 1
stack push 2
puts [stack pop]
puts [stack size]}
    out {2
1}
    p {This is how well-organised Tcl libraries look: `stack push`, `stack pop`, `stack size`. Later, TclOO will give you another way to bundle state and behaviour.}
  }}
}
ex {
  {kind predict code {namespace eval a {proc hi {} {return "from a"}}
puts [a::hi]} choices {{from a} hi a {}} ans 0 why {The proc lives in namespace `a` and is reached with `a::hi`.}}
  {kind predict code {namespace eval ctr {
    variable c 10
    proc up {} {variable c; incr c}
}
ctr::up
puts [ctr::up]} choices {12 11 10 1} ans 0 why {Each call adds one to the namespace variable: 11, then 12.}}
  {kind predict code {namespace eval m {
    namespace export sq
    proc sq {x} {expr {$x * $x}}
}
namespace import m::sq
puts [sq 6]} choices {36 12 6 {}} ans 0 why {After the import, `sq` can be used without the `m::` prefix.}}
  {kind predict code {namespace eval acc {
    variable list {}
    proc add {x} {variable list; lappend list $x}
    proc all {} {variable list; return $list}
    namespace export add all
    namespace ensemble create
}
acc add 1
acc add 2
puts [acc all]} choices {{1 2} {2 1} 1 {}} ans 0 why {`acc add` and `acc all` are subcommands created by the ensemble.}}
  {kind mc q {What does `namespace export` do?} choices {{Marks commands that others may import or that become ensemble subcommands} {Saves the namespace to disk} {Deletes the namespace} {Makes commands faster}} ans 0 why {Exported names can be imported elsewhere with `namespace import`.}}
  {kind mc q {Why use namespaces?} choices {{To avoid clashes between names in big programs} {To make code run in parallel} {Because procs need them} {To hide variables from the user}} ans 0 why {Each namespace has its own set of names.}}
  {kind blank q {Declare the namespace variable inside the proc.} code {namespace eval t {
    variable total 0
    proc add {n} {
        ___ total
        incr total $n
    }
}
t::add 5
puts [t::add 2]} answers {variable} extra {global set upvar} out {7} why {Inside a namespace proc, `variable name` links to the namespace variable.}}
  {kind type q {Which command creates a namespace (or runs code inside one)?} accept {namespace eval} why {`namespace eval name {...}`.}}
}
cards {
  {{How do you create a namespace and add a proc?} {`namespace eval name {proc p {} {...}}` - call it as `name::p`.}}
  {{What does `namespace ensemble create` do?} {Turns the namespace's exported commands into subcommands: `stack push 1`.}}
  {{How do you use a namespace variable in a proc?} {`variable name` inside the proc.}}
  {{How do you use the short name of a command from another namespace?} {`namespace import other::cmd` (the other namespace must export it).}}
}
}
} content/u11.tcl {content::unit 11 "Expert Tcl" "Coroutines, objects, traces, events, safe sandboxes, performance and Tk." "#FBBF24"

content::lesson 11.1 11 "Coroutines" "Procedures that can pause and resume - generators, two-way conversations and state." {
pages {
  {head "yield and coroutine" body {
    p {A **coroutine** is a procedure that can **pause** with `yield` and later **resume** exactly where it stopped, with all its local variables intact. `coroutine name command` creates one; afterwards calling `name` resumes it.}
    code {proc counter {} {
    yield
    set i 0
    while 1 {yield [incr i]}
}
coroutine next counter
puts [next]
puts [next]
puts [next]}
    out {1
2
3}
    p {The first `yield` is just a starting gate: `coroutine next counter` runs `counter` until it reaches it. After that, each call to `next` runs until the next `yield`, which hands a value back.}
  }}
  {head "Generators" body {
    p {A coroutine is a perfect **generator** - a source of values produced on demand, even an endless one. Here are the Fibonacci numbers:}
    code {proc fib {} {
    yield
    set a 0
    set b 1
    while 1 {
        yield $a
        lassign [list $b [expr {$a + $b}]] a b
    }
}
coroutine nextfib fib
set out {}
for {set i 0} {$i < 8} {incr i} {lappend out [nextfib]}
puts $out}
    out {0 1 1 2 3 5 8 13}
    tip {Without coroutines you would need to store the state in global variables and write the logic "inside out". The loop above reads like the maths.}
  }}
  {head "Two-way conversations" body {
    p {Values travel **both** ways. The argument you pass when resuming becomes the result of `yield` inside the coroutine.}
    code {proc acc {} {
    set total 0
    set v [yield]
    while 1 {
        incr total $v
        set v [yield $total]
    }
}
coroutine sum acc
puts [sum 5]
puts [sum 10]
puts [sum 100]}
    out {5
15
115}
    p {Each coroutine has its own private stack, so you can run many at once. `info coroutine` gives the name of the current one, and the Events and timers lesson shows a very powerful use of that.}
  }}
}
ex {
  {kind predict code {proc gen {} {
    yield
    yield a
    yield b
}
coroutine g gen
puts [g]
puts [g]} choices {"a\nb" "b\na" "a\na" "a"} ans 0 why {The first `g` resumes to the second `yield` (returning a), the next to the third (returning b).}}
  {kind predict code {proc evens {} {
    yield
    set n 0
    while 1 {yield $n; incr n 2}
}
coroutine e evens
e; e
puts [e]} choices {4 2 0 6} ans 0 why {Three calls give 0, 2, then 4 - and `puts` shows the third.}}
  {kind predict code {proc echo {} {
    set v [yield]
    while 1 {set v [yield "got $v"]}
}
coroutine ec echo
puts [ec ping]} choices {{got ping} ping {} ec} ans 0 why {The argument `ping` becomes the result of `yield`, and the coroutine hands back `got ping`.}}
  {kind mc q {What does `yield` do inside a coroutine?} choices {{Pauses it and hands a value back to the caller} {Ends the program} {Starts a new coroutine} {Prints a value}} ans 0 why {The coroutine's whole state is kept until it is resumed.}}
  {kind mc q {What is a good use of a coroutine?} choices {{A generator that produces values on demand} {Renaming files} {Comparing strings} {Printing tables}} ans 0 why {Generators and cooperative tasks are the classic uses.}}
  {kind blank q {Create a coroutine named tick from the proc ticker.} code {proc ticker {} {yield; yield 1; yield 2}
___ tick ticker
puts [tick]} answers {coroutine} extra {proc yield eval} out {1} why {`coroutine name command` starts it; it stops at the first `yield`.}}
  {kind type q {Which command pauses a coroutine and returns a value?} accept {yield} why {`yield`.}}
  {kind code prompt {Write a proc **squares** to be used as a coroutine: after `coroutine sq squares`, each call of `sq` returns the next square number 1, 4, 9, 16...} starter {proc squares {} {
    yield
    return
}} solution {proc squares {} {
    yield
    set n 1
    while 1 {
        yield [expr {$n * $n}]
        incr n
    }
}} tests {{coroutine sq squares; list [sq] [sq] [sq]} {1 4 9}} why {Yield once to start, then yield `n * n` forever, incrementing `n` between yields.}}
}
cards {
  {{What does `yield` do?} {Pauses a coroutine and returns a value to its caller; the coroutine resumes later where it stopped.}}
  {{How do you create and use a coroutine?} {`coroutine name command ...`, then call `name` to resume it.}}
  {{What is a generator?} {A coroutine that produces a sequence of values on demand, one per resume.}}
  {{How does data get into a coroutine?} {The argument you pass when resuming becomes the result of `yield`.}}
}
}

content::lesson 11.2 11 "Objects with TclOO" "Bundle data and behaviour into classes." {
pages {
  {head "Classes and objects" body {
    p {**TclOO** is Tcl's built-in object system. A **class** is a blueprint; an **object** is one thing built from it. `oo::class create` makes a class, `new` makes an object, and the object's name becomes a command.}
    code {oo::class create Counter {
    variable n
    constructor {} {set n 0}
    method incr {} {incr n}
    method value {} {return $n}
}
set c [Counter new]
$c incr
$c incr
puts [$c value]}
    out {2}
    p {`variable` lists the object's private data, `constructor` runs when the object is created, and each `method` is a command the object understands. Two objects have separate data.}
  }}
  {head "Inheritance" body {
    p {A class can build on another with `superclass`. It inherits everything and may **override** methods. Inside a method, `my` calls the object's own methods.}
    code {oo::class create Animal {
    variable name
    constructor {n} {set name $n}
    method speak {} {return "..."}
    method describe {} {return "$name says [my speak]"}
}
oo::class create Dog {
    superclass Animal
    method speak {} {return "Woof"}
}
puts [[Animal new Rex] describe]
puts [[Dog new Fido] describe]}
    out {Rex says ...
Fido says Woof}
    p {`describe` is written once in `Animal`, yet calls the right `speak` for each kind of animal. That is **polymorphism**.}
  }}
  {head "Extending with next" body {
    p {An overriding method can still use the original through `next`. Objects can be removed with `destroy`.}
    code {oo::class create Base {
    method hello {} {return "hello"}
}
oo::class create Loud {
    superclass Base
    method hello {} {return "[string toupper [next]]!"}
}
set o [Loud new]
puts [$o hello]
$o destroy
puts [llength [info commands $o]]}
    out {HELLO!
0}
    tip {TclOO also offers mixins, filters, class variables and introspection (`info object`). It stays small because it is built on the same idea as the rest of Tcl: everything is a command.}
  }}
}
ex {
  {kind predict code {oo::class create Box {
    variable v
    constructor {x} {set v $x}
    method get {} {return $v}
}
set b [Box new 42]
puts [$b get]} choices {42 v Box {}} ans 0 why {The constructor stored 42 in the object's variable `v`; `get` returns it.}}
  {kind predict code {oo::class create C {
    variable n
    constructor {} {set n 0}
    method up {} {incr n}
}
set a [C new]
set b [C new]
$a up
$a up
puts [$b up]} choices {1 3 2 0} ans 0 why {Each object has its own `n`, so `b` starts at 0 and `up` makes it 1.}}
  {kind predict code {oo::class create P {method who {} {return parent}}
oo::class create Q {superclass P}
puts [[Q new] who]} choices {parent Q P {}} ans 0 why {`Q` inherits `who` from `P`.}}
  {kind predict code {oo::class create P {method who {} {return p}}
oo::class create Q {
    superclass P
    method who {} {return "q+[next]"}
}
puts [[Q new] who]} choices {q+p p q q+q} ans 0 why {`next` calls the parent class's version of the method.}}
  {kind mc q {What is `my` for inside a method?} choices {{Calling the object's own methods} {Printing the object} {Making a copy} {Destroying the object}} ans 0 why {`my speak` calls the `speak` method of the current object (respecting overrides).}}
  {kind mc q {What is the difference between a class and an object?} choices {{A class is a blueprint; an object is one thing made from it} {They are the same} {An object is a blueprint} {A class has no methods}} ans 0 why {You create objects from a class with `new`.}}
  {kind blank q {Create an object of the class Dog.} code {oo::class create Dog {method speak {} {return Woof}}
set d [Dog ___]
puts [$d speak]} answers {new} extra {create make init} out {Woof} why {`ClassName new` creates an object.}}
  {kind type q {Which keyword names the parent class in a TclOO class definition?} accept {superclass} why {`superclass`.}}
}
cards {
  {{How do you create a class and an object?} {`oo::class create Name {...}` and then `set o [Name new]`.}}
  {{What are `constructor`, `method` and `variable` in a class?} {Code that runs on creation, a command the object understands, and the object's private data.}}
  {{How does inheritance work in TclOO?} {`superclass Parent` - the subclass inherits methods and can override them, calling the original with `next`.}}
  {{What does `my` do in a method?} {Calls another method of the same object.}}
}
}

content::lesson 11.3 11 "Traces and introspection" "Watch variables and commands, and ask Tcl about itself." {
pages {
  {head "Watching variables" body {
    p {A **trace** runs a command whenever something happens to a variable (it is read, written or removed). The handler is called with the variable name, array index and the operation.}
    code {proc watch {name1 name2 op} {
    upvar 1 $name1 v
    puts "x is now $v"
}
trace add variable x write watch
set x 1
set x 2}
    out {x is now 1
x is now 2}
    p {Traces are how a user interface can stay in sync with data: change the variable, and the display updates itself. (Tk's `-textvariable` options work this way.)}
  }}
  {head "Watching commands" body {
    p {`trace add execution` runs code when a command starts (`enter`) or finishes (`leave`), which makes debugging and logging simple.}
    code {proc work {} {return done}
proc note {cmd op} {puts "calling: $cmd"}
trace add execution work enter note
puts [work]}
    out {calling: work
done}
    p {You can also trace `rename` and `delete` of commands. `trace remove` switches a trace off, and `trace info` lists what is installed.}
  }}
  {head "Asking Tcl about itself" body {
    p {`info` can answer almost any question about the running program: which variables exist, which procs are defined, how deep the call stack is, what the current proc was called with.}
    code {proc f {a b} {
    set c 3
    return [lsort [info vars]]
}
puts [f 1 2]
proc who {} {info level 0}
puts [who]
proc caller {} {info level -1}
proc outer {} {caller}
puts [outer]
puts [lsort [info commands string]]}
    out {a b c
who
outer
string}
    tip {Together with `uplevel`, `upvar`, `rename` and `trace`, introspection is what lets Tcl programs build debuggers, testing frameworks and entire new languages.}
  }}
}
ex {
  {kind predict code {proc log {n1 n2 op} {puts "changed"}
trace add variable v write log
set v 1
set v 2} choices {"changed\nchanged" changed "" "changed\nchanged\nchanged"} ans 0 why {The trace fires on each write.}}
  {kind predict code {proc show {n1 n2 op} {puts $op}
trace add variable q read show
set q 5
set z $q} choices {read write "write\nread" ""} ans 0 why {Only reading `q` (the second line) triggers the read trace.}}
  {kind predict code {proc t {} {return ok}
proc note {c o} {puts "enter $o"}
trace add execution t enter note
t} choices {{enter enter} ok {enter t} {}} ans 0 why {The handler gets the command string and the operation name `enter`.}}
  {kind predict code {proc p {x y} {set z 1; return [lsort [info vars]]}
puts [p 1 2]} choices {{x y z} {x y} z {}} ans 0 why {`info vars` lists the proc's local variables, parameters included.}}
  {kind predict code {proc who {} {info level 0}
puts [who]} choices {who {} 0 level} ans 0 why {`info level 0` is the command that is currently running.}}
  {kind mc q {What is a trace for?} choices {{Running code automatically when a variable or command is used} {Drawing a line} {Sorting lists} {Reading files}} ans 0 why {Traces react to events on variables and commands.}}
  {kind blank q {React when the variable is written.} code {proc note {a b c} {puts "written"}
trace add variable w ___ note
set w 1} answers {write} extra {read unset change} out {written} why {The operations are `read`, `write` and `unset`.}}
  {kind type q {Which command tells you about the running program (its procs, variables, call stack)?} accept {info} why {`info`.}}
}
cards {
  {{How do you run code when a variable changes?} {`trace add variable name write handler`}}
  {{What arguments does a variable trace handler receive?} {The variable name, the array index (or empty), and the operation: read, write or unset.}}
  {{What does `trace add execution cmd enter handler` do?} {Calls the handler every time the command starts running.}}
  {{What does `info level 0` return?} {The command (with its arguments) currently being executed.}}
}
}

content::lesson 11.4 11 "Events and timers" "Programs that react: timers, waiting and non-blocking code." {
pages {
  {head "The event loop" body {
    p {Interactive programs do not run top to bottom and stop. They sit in an **event loop**, waiting for something to happen - a timer, a click, data arriving - and then run the matching code. Tk programs, like this app, live in this loop.}
    code {after 50 {set done yes}
vwait done
puts "timer fired"}
    out {timer fired}
    p {`after ms script` schedules a script to run later. `vwait variable` **waits inside the event loop** until the variable is set, so timers (and everything else) keep working meanwhile.}
  }}
  {head "Repeating and cancelling" body {
    p {A timer runs once. To repeat, let the script schedule itself again. `after cancel` removes a pending timer, and `after idle` runs code as soon as nothing else is waiting.}
    code {set n 0
proc tick {} {
    global n
    incr n
    puts "tick $n"
    if {$n < 3} {after 10 tick} else {set ::finished 1}
}
tick
vwait finished}
    out {tick 1
tick 2
tick 3}
    code {set id [after 1000 {puts "never printed"}]
after cancel $id
puts "cancelled"}
    out {cancelled}
  }}
  {head "Sequential code without blocking" body {
    p {Here is a beautiful expert pattern: combine **coroutines** with **timers**. The coroutine asks the event loop to wake it later, then yields. It reads like ordinary step-by-step code, yet nothing ever blocks.}
    code {proc delay {ms} {after $ms [list [info coroutine]]; yield}
proc job {} {
    puts "start"
    delay 20
    puts "after 20 ms"
    delay 20
    puts "finished"
    set ::done 1
}
coroutine j job
vwait done}
    out {start
after 20 ms
finished}
    tip {This is the idea behind "async/await" in other languages. In Tcl it takes six lines and no special syntax.}
  }}
}
ex {
  {kind predict code {after 10 {set go 1}
vwait go
puts [set go]} choices {1 go {} 10} ans 0 why {`vwait` returned when the timer set `go` to 1.}}
  {kind predict code {set id [after 100 {puts hidden}]
after cancel $id
puts shown} choices {shown hidden "hidden\nshown" ""} ans 0 why {The timer was cancelled, so only the last line prints.}}
  {kind predict code {set order {}
after 30 {lappend order slow; set ::d 1}
after 10 {lappend order fast}
vwait d
puts $order} choices {{fast slow} {slow fast} fast slow} ans 0 why {Timers fire by time, not by the order they were created.}}
  {kind mc q {What does `vwait var` do?} choices {{Waits, while processing events, until the variable is set} {Sleeps and blocks everything} {Creates a variable} {Prints a variable}} ans 0 why {Unlike a sleep, `vwait` lets timers and other events keep running.}}
  {kind mc q {How do you make a timer repeat?} choices {{The scheduled script schedules itself again} {Use `after forever`} {Use two `after` commands} {It repeats by default}} ans 0 why {Each run schedules the next one.}}
  {kind blank q {Run the script after 20 milliseconds.} code {___ 20 {set ok 1}
vwait ok
puts $ok} answers {after} extra {wait later sleep} out {1} why {`after ms script` schedules the script.}}
  {kind type q {Which command cancels a scheduled timer?} accept {after cancel} why {`after cancel $id`.}}
}
cards {
  {{What does `after 500 script` do?} {Schedules the script to run once, 500 ms later, from the event loop.}}
  {{What does `vwait var` do?} {Runs the event loop until the variable is written, then continues.}}
  {{How do you repeat something every so often?} {Make the script call `after ms script` again for itself.}}
  {{What is a good way to write non-blocking sequential code?} {A coroutine that does `after ms [list [info coroutine]]; yield` to sleep.}}
}
}

content::lesson 11.5 11 "Interpreters, safety and packages" "Isolated worlds, running untrusted code, and sharing libraries." {
pages {
  {head "Separate interpreters" body {
    p {An **interpreter** is an independent Tcl world with its own commands and variables. `interp create` makes another one inside your program, and `eval` runs code in it. Nothing leaks across unless you allow it.}
    code {set i [interp create]
$i eval {set secret 42}
puts [$i eval {expr {$secret + 1}}]
puts [info exists secret]
interp delete $i}
    out {43
0}
    p {This is how this app runs **your** code safely: each Playground run happens in a fresh interpreter, with time and output limits.}
  }}
  {head "Safe interpreters and aliases" body {
    p {`interp create -safe` makes a **safe** interpreter that has no access to files, processes or the network - suitable for untrusted code such as plugins or scripts from users.}
    code {set s [interp create -safe]
puts [catch {$s eval {open /etc/passwd}} msg]
puts $msg}
    out {1
invalid command name "open"}
    p {A safe interpreter can still be given **specific** abilities. An **alias** is a command inside it that runs a command in the parent - you decide exactly what is exposed.}
    code {$s alias hello apply {{} {return "from the host"}}
puts [$s eval hello]}
    out {from the host}
    tip {`interp limit` can also cap run time or the number of commands. That is exactly what stops an endless loop in the Playground.}
  }}
  {head "Packages and modules" body {
    p {Libraries are shared as **packages**. A package announces itself with `package provide` and is loaded with `package require`, which also returns the version.}
    code {package provide mathx 1.0
namespace eval mathx {
    proc square {x} {expr {$x * $x}}
}
puts [package require mathx]
puts [mathx::square 9]}
    out {1.0
81}
    p {Real packages live in files. A `pkgIndex.tcl` tells Tcl where a package is, and single-file **Tcl modules** (`name-1.0.tm`) are found through `tcl::tm::path`. `source file` runs another script, which is how you split a program into parts - this app does exactly that. The huge **Tcllib** collection provides JSON, CSV, HTTP, sets, matrices and much more.}
  }}
}
ex {
  {kind predict code {set i [interp create]
$i eval {set v 7}
puts [$i eval {incr v}]} choices {8 7 v {}} ans 0 why {The variable lives inside the other interpreter, where `incr` makes it 8.}}
  {kind predict code {set i [interp create]
$i eval {set only_there 1}
puts [info exists only_there]} choices {0 1 only_there {}} ans 0 why {Interpreters do not share variables.}}
  {kind predict code {set s [interp create -safe]
puts [catch {$s eval {exec ls}}]} choices {1 0 ls {}} ans 0 why {`exec` is not available in a safe interpreter, so evaluating it raises an error.}}
  {kind predict code {set i [interp create]
$i alias twice apply {{x} {expr {$x * 2}}}
puts [$i eval {twice 21}]} choices {42 21 twice {}} ans 0 why {The alias in the child calls the function in the parent.}}
  {kind predict code {package provide demo 2.5
puts [package require demo]} choices {2.5 demo 1 {}} ans 0 why {`package require` returns the version that is available.}}
  {kind mc q {Why run user code in a safe interpreter?} choices {{It cannot touch files, processes or the network unless you allow it} {It runs faster} {It uses less memory} {It has more commands}} ans 0 why {Safety by default - you add abilities one by one with aliases.}}
  {kind mc q {What does an alias in a safe interpreter do?} choices {{Gives the child a command that runs a specific command in the parent} {Renames a variable} {Makes the child unsafe} {Deletes the parent}} ans 0 why {Aliases are the controlled doorway between the two worlds.}}
  {kind type q {Which command creates a separate Tcl interpreter?} accept {interp create} why {`interp create`.}}
}
cards {
  {{What does `interp create` do?} {Makes an independent Tcl interpreter with its own commands and variables; `$i eval {...}` runs code in it.}}
  {{What is special about `interp create -safe`?} {The interpreter has no access to files, processes or the network - good for untrusted code.}}
  {{What is an interp alias for?} {To give a safe interpreter one specific, controlled ability by running a command in the parent.}}
  {{How do you declare and use a package?} {`package provide name version` in the library, `package require name` in the user.}}
}
}

content::lesson 11.6 11 "Performance and style" "Write Tcl that is correct, safe, quick and pleasant to read." {
pages {
  {head "Always brace your expressions" body {
    p {`expr` should nearly always get its expression in **braces**. Braced expressions are compiled once to fast bytecode, and they are **safe**. Without braces, Tcl substitutes first and then evaluates the result - so data can run as code.}
    code {set input {[puts HACKED]}
catch {expr $input} r
puts "unbraced -> '$r'"
catch {expr {$input}} r2
puts "braced -> $r2"}
    out {HACKED
unbraced -> ''
braced -> [puts HACKED]}
    warn {The unbraced form ran the command hidden inside the data. The same rule applies to `if`, `while` and `for` conditions: always use braces.}
  }}
  {head "Measure, then improve" body {
    p {Do not guess where time goes: **measure**. `time {script} count` runs a script `count` times and reports the average.}
    code {set t [time {
    set s 0
    for {set i 0} {$i < 1000} {incr i} {incr s $i}
} 50]
puts [string match "*microseconds per iteration" $t]}
    out {1}
    p {Typical wins, each worth knowing:}
    p {- Use `lappend` to grow a list, not `set l "$l $x"` (which copies the whole list each time)
- Use `append` to build long strings
- Use a **dict or array** for lookups instead of searching a list inside a loop
- Use `lsearch -sorted` on sorted data
- Do work **once**, outside the loop}
  }}
  {head "Habits of good Tcl" body {
    p {Fast code that nobody can read is a bad trade. These habits make Tcl clear:}
    p {- Brace everything that is code or an expression
- Keep procs short and give them one job
- Return values instead of using globals; pass **data**, not variable names, unless you mean to modify them
- Never build code by gluing strings - use `list` and `{*}`
- Handle errors where you can do something about them
- Write a few tests (Tcl ships with the `tcltest` package)}
    tip {You can now read the source of this very app: it is a few thousand lines of ordinary Tcl and Tk, built from exactly the ideas in this course.}
  }}
}
ex {
  {kind mc q {Why should you write `expr {$a + $b}` rather than `expr $a + $b`?} choices {{It is faster and prevents the values from being run as code} {It is required} {It rounds the answer} {It allows decimals}} ans 0 why {Braced expressions are bytecode-compiled and avoid double substitution.}}
  {kind mc q {Which is the better way to grow a list inside a loop?} choices {{lappend result $x} {set result "$result $x"} {set result [concat $result $x]} {They are equal}} ans 0 why {`lappend` appends in place; the others copy the whole list each time.}}
  {kind mc q {You search a long list inside a loop over thousands of items. What is a better approach?} choices {{Put the lookup data in a dict or array first} {Use a bigger list} {Use `eval`} {Sort after every search}} ans 0 why {A dict lookup is nearly instant, while a list search checks items one by one.}}
  {kind predict code {set input {[puts X]}
puts [expr {$input}]} choices {{[puts X]} X {} 0} ans 0 why {A braced expression treats the value as plain data and does not run the command inside.}}
  {kind mc q {What does `time {script} 100` report?} choices {{The average time of one run of the script} {The total time in minutes} {The time of day} {How many commands ran}} ans 0 why {It runs the script 100 times and gives microseconds per iteration.}}
  {kind mc q {How should you assemble a command from user-supplied parts?} choices {{With `list` and then run it with `{*}$cmd`} {By joining strings with spaces} {With `format`} {With `subst`}} ans 0 why {`list` keeps each part as exactly one word.}}
  {kind blank q {Add to the end of a string efficiently.} code {set s "ab"
___ s "cd"
puts $s} answers {append} extra {lappend set concat} out {abcd} why {`append` extends the variable in place.}}
  {kind type q {Which command measures how long a script takes?} accept {time} why {`time script count`.}}
}
cards {
  {{Why brace expressions: `expr {...}`?} {They compile to fast bytecode and are safe from double substitution (code injection).}}
  {{What is the efficient way to grow a list or a string?} {`lappend` for lists and `append` for strings.}}
  {{How do you measure performance?} {`time {script} count` gives microseconds per iteration.}}
  {{How do you avoid slow lookups in loops?} {Use a dict or array instead of searching a list.}}
}
}

content::lesson 11.7 11 "Tk: the other half of Tcl" "Build windows and apps - the toolkit this very app is made of." {
pages {
  {head "A window in four lines" body {
    p {**Tk** is Tcl's graphical toolkit. Every window, button and label is a **widget** with a **path name** that starts with a dot and nests by dots: `.` is the main window, `.frame.button` is a button inside a frame.}
    show {package require Tk
label .hello -text "Hello, Tk!"
button .quit -text "Quit" -command exit
pack .hello .quit -padx 20 -pady 10}
    p {- A widget command (`label`, `button`, `entry`, `canvas`, `text`, `frame`...) creates the widget
- Options start with a dash: `-text`, `-command`, `-width`, `-bg`
- A **geometry manager** (`pack`, `grid`, `place`) puts it on screen
- `-command` takes a command prefix - the same idea as before}
    tip {Tk code needs a screen, so these examples are not run in the Playground. Try them on a computer with `wish`, which comes with Tcl/Tk.}
  }}
  {head "Events and variables" body {
    p {`bind` attaches a script to an event such as a click, key press or mouse movement. `%x` and `%y` in the script become the event's coordinates. `-textvariable` links a widget to a variable, using a trace under the hood.}
    show {entry .name -textvariable who
label .greet -textvariable msg
bind .name <KeyRelease> {
    set msg "Hello, $who!"
}
pack .name .greet}
    show {canvas .c -width 200 -height 100
pack .c
proc dot {x y} {
    set x1 [expr {$x - 5}]
    set y1 [expr {$y - 5}]
    set x2 [expr {$x + 5}]
    set y2 [expr {$y + 5}]
    .c create oval $x1 $y1 $x2 $y2 -fill red
}
bind .c <Button-1> {dot %x %y}}
    p {The second half draws a red dot wherever you click on the canvas. The canvas is also what draws every rounded button, card and icon in this app - and `after` (from the events lesson) drives animations like the confetti.}
  }}
  {head "Where next?" body {
    p {You have gone from "what is a program?" to coroutines, objects, safe interpreters and Tk. Real mastery comes from building things. Some ideas, easiest first:}
    p {- A to-do list or notes app (files, lists, a Tk listbox)
- A flashcard or quiz program of your own
- A text-adventure or a Tk game (a canvas and `after`)
- A tiny web server using `socket` and `fileevent`
- A library in a namespace, packaged with `package provide`, with tests}
    p {Keep this app's habits: retrieve, don't re-read; practise little and often; build something every week. Read the reference at **tcl-lang.org** and the community wiki at **wiki.tcl-lang.org**, and read this app's own source - it is yours to change.}
    tip {You can finish by opening `lib/ui.tcl` and changing the colours in `lib/theme.tcl`. Changing a program you use every day is the fastest way to learn.}
  }}
}
ex {
  {kind mc q {What does the dot in a Tk path name like `.frame.button` mean?} choices {{It separates a widget from its parent: the button is inside the frame} {A decimal point} {A comment} {The end of the name}} ans 0 why {Path names mirror the widget hierarchy, starting at `.` the main window.}}
  {kind mc q {What does `pack` do?} choices {{Places a widget on screen (it is a geometry manager)} {Compresses files} {Creates a widget} {Packs a list}} ans 0 why {Widgets are created by their class command, then positioned by `pack`, `grid` or `place`.}}
  {kind mc q {What does this code do?} code {button .b -text "Go" -command {puts clicked}} choices {{Creates a button that runs `puts clicked` when pressed} {Prints clicked immediately} {Creates a label} {Removes the button}} ans 0 why {`-command` holds a script that runs when the button is pressed.}}
  {kind mc q {What is `bind` for?} choices {{Running a script when an event such as a click or key press happens} {Joining two strings} {Creating variables} {Declaring a namespace}} ans 0 why {`bind widget <Event> script`.}}
  {kind mc q {Which option keeps a label in sync with a variable?} choices {-textvariable -text -command -variable} ans 0 why {`-textvariable` watches the variable and redraws the label when it changes.}}
  {kind type q {Which widget command creates a drawing surface for shapes and lines?} accept {canvas} why {`canvas`.}}
  {kind type q {Complete the line that loads the graphical toolkit: `package require ...`} accept {Tk} why {`package require Tk`.}}
}
cards {
  {{What is a Tk widget path name?} {A dotted name like `.frame.button`; `.` is the main window and each dot nests a child inside its parent.}}
  {{What are `pack`, `grid` and `place`?} {Geometry managers: they put widgets on the screen.}}
  {{What does `bind .w <Button-1> script` do?} {Runs the script when the left mouse button is clicked on the widget.}}
  {{What does `-textvariable` do?} {Links a widget's text to a variable, so it updates automatically.}}
}
}
}}
#!/usr/bin/env wish
# Learn Tcl - a spaced-repetition course in Tcl, written in Tcl/Tk.
# Run with:  wish main.tcl        (desktop)   or open in AndroWish (Android)
package require Tk

set ::app_lib {util theme store srs sandbox content aa ui flat exercises runner screens}
set ::app_content {u01 u02 u03 u04 u05 u06 u07 u08 u09 u10 u11}

namespace eval boot {
    variable root [file dirname [file normalize [info script]]]
    # Load a source file, from the embedded bundle if there is one.
    proc load {rel} {
        variable root
        if {[info exists ::EMBED($rel)]} {
            uplevel #0 $::EMBED($rel)
        } else {
            uplevel #0 [list source -encoding utf-8 [file join $root $rel]]
        }
    }
}

foreach f $::app_lib     { boot::load lib/$f.tcl }
foreach f $::app_content { boot::load content/$f.tcl }

proc boot::main {} {
    set android [llength [info commands borg]]
    if {$android} {
        catch {wm attributes . -fullscreen 1}
        update
        set W [expr {min([winfo screenwidth .], [winfo screenheight .])}]
    } else {
        set W 410
        wm geometry . ${W}x840
        wm minsize . 300 500
        update
        set W [winfo width .]
    }
    set ::ui::U [expr {$W / 100.0}]
    app::init
    sandbox::init [expr {$store::dir ne "" ? $store::dir : [pwd]}]
    app::go home
    foreach k {<Escape> <Cancel> <XF86Back> <Key-Escape>} { catch {bind . $k app::back} }
    app::fit
}
if {![info exists ::LEARNTCL_NO_MAIN]} { boot::main }
